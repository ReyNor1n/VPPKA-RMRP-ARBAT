rules_version = '2';
// ВППКА — правила Firestore. Публикуются владельцем в консоли Firebase:
// Firestore Database → Rules → вставить весь этот текст → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- помощники ----------
    function signedIn() { return request.auth != null; }
    function docs() { return /databases/$(database)/documents; }
    function keyPath(h) { return /databases/$(database)/documents/accessKeys/$(h); }
    function isHash(h) { return h is string && h.matches('^[0-9a-f]{64}$'); }

    // Владелец: uid перечислен в config/owners.uids (документ создаётся только из консоли)
    function isOwner() {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/config/owners).data.uids;
    }
    // Суперпользователь (Начальник технического отдела) = владелец из config/owners.
    // Документ owners пишется только из консоли, поэтому право нельзя выдать себе с сайта.
    function isSuper() { return isOwner(); }
    // Действующий ключ пользователя (данные accessKeys/{keyHash}) или {} если ключа нет / аннулирован
    function myKey() {
      let up = /databases/$(database)/documents/users/$(request.auth.uid);
      let u = exists(up) ? get(up).data : {};
      let h = u.get('keyHash', '');
      let k = isHash(h) && exists(keyPath(h)) ? get(keyPath(h)).data : {};
      return k.get('revoked', false) == false && k.get('discordId', null) == u.get('discordId', '')
          && request.auth.token.email == u.get('discordId', '') + '@vppka.local'
        ? k : {};
    }
    function keyRank() { return myKey().get('rank', 0); }
    // Ступень (tier) = первая цифра ключа, хранится в accessKeys.tier (ключи хэшированы)
    function keyTier() { return myKey().get('tier', 0); }
    // Доп. право: ключ с canEditChairman==true может править запись председателя (ранг 100)
    function canChair() { return signedIn() && myKey().get('canEditChairman', false) == true; }
    // Доп. право: ключ с canViewMembers==true видит список участников партии (users)
    function canMembers() { return signedIn() && myKey().get('canViewMembers', false) == true; }
    // Ступень владельца = 9 (выше любого ключа)
    // v275: держатель места «Администратор сайта» (m13) без ключа получает ступень 6 (выше — только ключ 7+ и владелец).
    function myTier() { return !signedIn() ? 0 : (isOwner() ? 9 : (keyTier() < 6 && siteAdmDid(myVDid()) ? 6 : keyTier())); }
    // Ступень другого пользователя по его ключу (нет ключа → 0)
    function userTier(uid) {
      let up = /databases/$(database)/documents/users/$(uid);
      let h = exists(up) ? get(up).data.get('keyHash', '') : '';
      return isHash(h) && exists(keyPath(h)) && get(keyPath(h)).data.get('revoked', false) == false
        ? get(keyPath(h)).data.get('tier', 0) : 0;
    }
    // член партии: действующий ключ, принятая заявка с id = uid, или отметка mem/{uid} (ставит бот/админ)
    function partyMember() {
      return signedIn() && (keyRank() >= 1
        || exists(/databases/$(database)/documents/mem/$(request.auth.uid))
        || (exists(/databases/$(database)/documents/applications/$(request.auth.uid))
            && get(/databases/$(database)/documents/applications/$(request.auth.uid)).data.status in ['accepted','member']));
    }
    function myRank() { return !signedIn() ? 0 : (isOwner() ? 1000 : keyRank()); }
    // аккаунт подтверждён: профиль users/{uid} существует (с v207 — создаётся при регистрации без кода, Discord ID = логин)
    // v222: «аккаунт на сайте должен быть привязан к Discord» — Discord ID подтверждён ботом: claim dv (вход/регистрация через
    // Discord) или отметка dvf/{uid} (код из ЛС). Проверенный аккаунт = профиль + привязка.
    function linked() {
      return signedIn() && (request.auth.token.get('dv', false) == true
        || exists(/databases/$(database)/documents/dvf/$(request.auth.uid)));
    }
    function verified() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && linked(); }
    // ---------- звания членов партии: менять могут только Председатель ЦК (m1), его заместители (m4, m5) и владелец сайта ----------
    // кто есть кто — по документам мест руководства (members/m1, m4, m5), а не по данным клиента
    // Звания; applications.partyRank 1..5 = rkList()[partyRank - 1]. «Кандидат» упразднён 20.10.2026.
    function rkList() { return ['Член партии','Активист','Старший член партии','Ветеран партии','Почётный член партии']; }
    function seatDoc(s) { return /databases/$(database)/documents/members/$(s); }
    // Нет документа места — пустой Discord, а не ошибка всего правила.
    function seatDid(s) { return get(seatDoc(s)).data.get('discordId', ''); }
    // Распорядители: владелец, Председатель ЦК (m1), его заместители (m4, m5) и заместитель начальника техотдела (m12).
    // v275: + «Администратор сайта» (m13). Распорядители не бывают целью смены звания (rkTargetOk) — и себя он не повышает.
    function rkAdminDids() { return ['646280678736003073', seatDid('m1'), seatDid('m4'), seatDid('m5'), seatDid('m12'), seatDid('m13')]; }
    // Председатель ЦК — тот, кто сейчас сидит на m1. Замы свои и чужие места m4/m5 не переназначают.
    function chairNow() { return isSuper() || (myVDid() != '' && myVDid() == seatDid('m1')); }
    function myVDid() {
      let up = /databases/$(database)/documents/users/$(request.auth.uid);
      let u = signedIn() && request.auth.token.email is string && exists(up) ? get(up).data : {};
      return u.get('discordId', '') != '' && request.auth.token.email == u.get('discordId', '') + '@vppka.local'
        ? u.discordId : '';
    }
    function rankAdmin() { return isOwner() || (myVDid() != '' && myVDid() in rkAdminDids()); }
    // v272: «Председатель ЦК и его замы получили все права на сайте, не связанные с админом».
    // Руководство = тот, кто сейчас сидит на m1, m4 или m5 (по документам мест, как rankAdmin), плюс владелец.
    // Админские права (ключи доступа, настройки сайта, тексты страниц, шаблоны, Discord-вебхуки, ldrSeats, общее правило isSuper) — по-прежнему только владелец.
    function chiefDid(vd) { return vd != '' && (vd == seatDid('m1') || vd == seatDid('m4') || vd == seatDid('m5')); }
    // v275: «Администратор сайта» — тот, кто сейчас сидит на m13 (по документу места, ключ не нужен).
    // Получает права руководства (isChief): награды, доп. должности, новости, мероприятия, карточки и т. д.,
    // но не меняет своё место, места техотдела/владельца (lockFree, lockedData), свои карточки и людей на m1/m4/m5.
    function siteAdmDid(vd) { return vd != '' && vd == seatDid('m13'); }
    function isChief() { return isOwner() || chiefDid(myVDid()) || siteAdmDid(myVDid()); }
    // v272: «Начальник пресс-службы» — доп. должность на карточке members/{c} того, кто вошёл (discordId = логин).
    // Карточку указывает сам автор (поле card в новости и в заявке discordOut); правила проверяют её по базе.
    function pressCardOk(c) {
      let vd = myVDid();
      return c is string && c.matches('^[A-Za-z0-9_-]{1,128}$') && vd != ''
        && exists(/databases/$(database)/documents/members/$(c))
        && get(/databases/$(database)/documents/members/$(c)).data.get('discordId', '') == vd
        && 'Начальник пресс-службы' in get(/databases/$(database)/documents/members/$(c)).data.get('subPositions', []);
    }
    // Discord ID всех, кто сейчас занимает места руководства: config/ldrSeats.dids.
    // Список целиком переписывают те, кто назначает (rankAdmin), после назначения или снятия.
    function ldrSeatsPath() { return /databases/$(database)/documents/config/ldrSeats; }
    // цель — рядовой член партии: не распорядитель званий и не обладатель места руководства; нет списка мест → запрет
    function rkTargetOk(did) {
      return did == '' || (!(did in rkAdminDids()) && !(did in get(ldrSeatsPath()).data.get('dids', [])));
    }

    // необязательное строковое поле не длиннее max
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function reqStr(d, k, max) { return (k in d) && d[k] is string && d[k].size() > 0 && d[k].size() <= max; }
    // v282: вынесены из match /news — объявления (notifications) тоже проверяют фото/ссылки.
    function newsUrl(u) { return u is string && u.size() <= 300 && u.matches('https://[^ "<>]+'); }
    function newsImg(u) { return u is string && (u.matches('https://[^ "<>]+') || u.matches('ph:[A-Za-z0-9]{20}')
        || u.matches('data:image/(png|jpeg|jpg|gif|webp|bmp|avif);base64,[A-Za-z0-9+/=]*') || u.matches('img/[^: "<>]+')); }

    // ---------- пользователи ----------
    match /users/{uid} {
      // Ключ либо отсутствует целиком, либо существует и rank/roleName совпадают с ключом
      function validKey(d) {
        return (!('keyHash' in d) && !('rank' in d) && !('roleName' in d))
          || (isHash(d.get('keyHash', null)) && exists(keyPath(d.keyHash))
              && get(keyPath(d.keyHash)).data.get('revoked', false) == false
              && get(keyPath(d.keyHash)).data.discordId == d.discordId
              && d.get('rank', null) == get(keyPath(d.keyHash)).data.rank
              && d.get('roleName', null) == get(keyPath(d.keyHash)).data.roleName);
      }
      function validUser(d) {
        return d.keys().hasOnly(['discordLink','discordId','displayName','createdAt','keyHash','rank','roleName','photo','avatar','fio','birth','passport','vcode','about'])
          && optStr(d, 'fio', 100) && optStr(d, 'about', 1500) && (!('birth' in d) || (d.birth is string && d.birth.matches('^[0-9]{2}[.][0-9]{2}[.][0-9]{4}$')))
          && (!('passport' in d) || (d.passport is string && d.passport.matches('^[0-9]{3}-[0-9]{3}$')))
          && reqStr(d, 'discordId', 64) && optStr(d, 'discordLink', 200) && optStr(d, 'displayName', 40)
          && (!('photo' in d) || (d.photo is string && d.photo.size() <= 410000 && (d.photo.matches('^data:image/(jpeg|gif);base64,.*') || d.photo.matches('^ph:[A-Za-z0-9]{20}$'))))
          && (!('avatar' in d) || (d.avatar is string && d.avatar.size() <= 410000 && (d.avatar.matches('^data:image/(jpeg|gif);base64,.*') || d.avatar.matches('^ph:[A-Za-z0-9]{20}$'))))
          && request.auth.token.email == d.discordId + '@vppka.local';
      }
      allow read: if signedIn() && (request.auth.uid == uid || isOwner() || canMembers() || myTier() >= 5);
      // ФИО персонажа (v207): 2–4 слова, буквы (кириллица/латиница) и дефис, до 100 символов
      function validFio(d) {
        return d.get('fio', '') is string && d.get('fio', '').size() <= 100
          && d.get('fio', '').matches('^[А-ЯЁа-яёA-Za-z]+(-[А-ЯЁа-яёA-Za-z]+)*( [А-ЯЁа-яёA-Za-z]+(-[А-ЯЁа-яёA-Za-z]+)*){1,3}$');
      }
      // новый аккаунт (v207): регистрация без кода из Discord. Профиль создаёт только сам пользователь (uid),
      // Discord ID = логин аккаунта (validUser: email == discordId@vppka.local, а email в Firebase Auth уникален),
      // ключ (keyHash/rank/roleName) — только настоящий (validKey), обязательно ФИО.
      // Discord ID руководства (места, распорядители званий, владелец) без кода не занять: такой профиль — только с кодом от бота
      // или после входа/регистрации через Discord (v216: custom token бота с claim dv=true — Discord ID подтверждён в ЛС).
      // v222: профиль — только с подтверждённым Discord ID (claim dv или dvf/{uid} с тем же Discord ID). Код vcode больше не принимается.
      allow create: if signedIn() && request.auth.uid == uid && validUser(request.resource.data) && validKey(request.resource.data)
        && validFio(request.resource.data) && !('vcode' in request.resource.data)
        && (request.auth.token.get('dv', false) == true
          || (exists(/databases/$(database)/documents/dvf/$(uid))
            && get(/databases/$(database)/documents/dvf/$(uid)).data.get('did', '') == request.resource.data.discordId));
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','keyHash','rank','roleName','photo','avatar','fio','birth','passport','about'])
        && validUser(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['keyHash','rank','roleName'])
            || validKey(request.resource.data));
      allow delete: if signedIn() && request.auth.uid == uid;
      // РП-данные персонажа (дата рождения, паспорт-статик): видят члены партии (ключ, принятая заявка или отметка mem/{uid}); гости — нет
      match /priv/{d} {
        allow read: if signedIn() && (request.auth.uid == uid || isOwner() || partyMember());
        // v258: пишет только аккаунт с подтверждённым Discord (linked: и при регистрации, до профиля)
        allow write: if linked() && request.auth.uid == uid && d == 'p'
          && request.resource.data.keys().hasOnly(['birth','passport'])
          && (!('birth' in request.resource.data) || (request.resource.data.birth is string && request.resource.data.birth.matches('^[0-9]{2}[.][0-9]{2}[.][0-9]{4}$')))
          && (!('passport' in request.resource.data) || (request.resource.data.passport is string && request.resource.data.passport.matches('^[0-9]{3}-[0-9]{3}$')))
          // v206: статик обязателен — однажды указанный нельзя стереть (сменить на другой в формате 000-000 можно)
          && (resource == null || !('passport' in resource.data) || 'passport' in request.resource.data);
      }
      // удаление гостя: владелец или ступень 4+; нельзя удалять держателей ключей, владельцев и служебный аккаунт
      allow delete: if signedIn() && (isOwner() || myTier() >= 4)
        && request.auth.uid != uid && uid != 'ZpVGAXbbg1a9I8kRsNEm0OU8QAt2'
        && resource.data.get('keyHash', '') == ''
        && !(uid in get(/databases/$(database)/documents/config/owners).data.uids);
    }

    // ---------- ключи доступа: id = sha256(ключ) hex; ключ привязан к одному discordId ----------
    // v230: выпуск и отзыв ключей — только ступень 7+ (владелец = 9) из раздела «Ключи доступа» админ-панели.
    // Сам ключ не хранится: id = sha256(ключ). Новый ключ — только новый документ (createdBy = uid, createdAt = время сервера);
    // изменить существующий можно только отозвать/вернуть (revoked, revokedAt) и подпись. Чтение по хэшу (вход по ключу) — как раньше.
    match /accessKeys/{h} {
      allow get: if signedIn();                 // нужно знать хэш, т.е. сам ключ
      allow list: if myTier() >= 7;             // список (без ключей) — раздел «Ключи доступа»
      allow create: if myTier() >= 7 && isHash(h)
        && request.resource.data.keys().hasOnly(['rank','roleName','discordId','label','createdBy','createdAt','revoked','revokedAt','canEditChairman','canViewMembers','tier'])
        && request.resource.data.tier is int && request.resource.data.tier >= 0 && request.resource.data.tier <= myTier()
        && (!('canEditChairman' in request.resource.data) || request.resource.data.canEditChairman is bool)
        && (!('canViewMembers' in request.resource.data) || request.resource.data.canViewMembers is bool)
        && request.resource.data.get('revoked', false) == false
        && request.resource.data.discordId is string && request.resource.data.discordId.matches('^[0-9]{15,21}$')
        && request.resource.data.rank is int && request.resource.data.rank >= 1
        && request.resource.data.rank < myRank()
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && reqStr(request.resource.data, 'roleName', 60) && optStr(request.resource.data, 'label', 100);
      allow update: if myTier() >= 7 && resource.data.rank < myRank()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked','revokedAt','label'])
        && request.resource.data.get('revoked', false) is bool && optStr(request.resource.data, 'label', 100);
      allow delete: if myTier() >= 7 && resource.data.rank < myRank();
    }

    // ---------- служебное: owners и вебхуки только из консоли; список должностей пишут назначающие ----------
    match /config/{d} {
      // discordTargets (v209): подписи «своих строк» каналов для «Куда отправить в Discord» — пишет только бот, без вебхуков
      // v222: config/discord (URL вебхуков) — только владелец; публикующие отправляют через бота (discordOut b_news/b_notices)
      allow get: if (signedIn() && d == 'owners') || (d == 'discord' && isOwner()) || (d == 'ldrSeats' && rankAdmin())
        || (d == 'discordTargets' && myTier() >= 4);
      // Список Discord тех, кто занимает руководящие места. Пишут те же, кто назначает: целиком поле dids.
      function didsOk() {
        return request.resource.data.dids is list && request.resource.data.dids.size() <= 80
          && (request.resource.data.dids.size() == 0 || (request.resource.data.dids[0] is string && request.resource.data.dids[0].size() <= 32));
      }
      // v222: список пишут только владелец и бот (Admin SDK держит его в соответствии с местами)
      allow create: if d == 'ldrSeats' && isOwner()
        && request.resource.data.keys().hasOnly(['dids']) && didsOk();
      allow update: if d == 'ldrSeats' && isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dids']) && didsOk();
      allow write: if d == 'discord' && isOwner()
        && request.resource.data.keys().hasOnly(['webhook','appsWebhook','roleIds'])
        && (!('webhook' in request.resource.data) || request.resource.data.webhook.matches('^https://(discord|discordapp)[.]com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+$'))
        && (!('appsWebhook' in request.resource.data) || request.resource.data.appsWebhook.matches('^https://(discord|discordapp)[.]com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+$'))
        && (!('roleIds' in request.resource.data) || (request.resource.data.roleIds is list && request.resource.data.roleIds.size() <= 10));
      allow list: if false;
    }

    // ---------- отправка новости/созыва в «свою строку» канала Discord (v209) ----------
    // Публикующий (ступень 4+, как для news/notifications) ставит заявку; бот берёт текст из самого документа ref,
    // проверяет строку и пишет итог (status, err, doneAt) сервисным ключом. Свою заявку автор может прочитать.
    match /discordOut/{id} {
      // v262: roles — какие роли упомянуть (до 5 id; бот берёт только роли из content/settings.discord.roles, @everyone — никогда)
      allow create: if request.resource.data.keys().hasOnly(['kind','ref','target','by','at','roles','card'])
        && request.resource.data.keys().hasAll(['kind','ref','target','by','at'])
        && (!('roles' in request.resource.data) || (request.resource.data.roles is list && request.resource.data.roles.size() <= 5))
        && request.resource.data.kind in ['news','notice','cancel','announcement']
        && request.resource.data.ref is string && request.resource.data.ref.matches('^[A-Za-z0-9_-]{1,64}$')
        // v222: b_news / b_notices — каналы «как обычно» (вебхуки config/discord видит только владелец, отправляет бот)
        && request.resource.data.target is string && request.resource.data.target.matches('^(c_[a-z0-9]{4,24}|b_news|b_notices)$')
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        // v275: пресс-служба проверяется первой (иначе myTier/isChief + место m13 съедают лимит 10 обращений к документам)
        && (pressOutOk() || myTier() >= 4 || isChief());
      allow get: if signedIn() && resource.data.by == request.auth.uid;
      allow list, update, delete: if false;
      // v272: пресс-служба отправляет только свою новость и только в канал новостей «как обычно» (b_news, бот).
      // v279: может выбрать, кого упомянуть (roles, до 5 — проверено выше); бот пропускает только роли сервера, @everyone/@here — никому.
      function pressOutOk() {
        let o = request.resource.data;
        return ((o.kind == 'news' && o.target == 'b_news'
          && exists(/databases/$(database)/documents/news/$(o.ref))
          && get(/databases/$(database)/documents/news/$(o.ref)).data.get('author', '') == request.auth.uid)
          || (o.kind == 'announcement' && o.target == 'b_notices'
          && exists(/databases/$(database)/documents/notifications/$(o.ref))
          && get(/databases/$(database)/documents/notifications/$(o.ref)).data.get('author', '') == request.auth.uid
          && get(/databases/$(database)/documents/notifications/$(o.ref)).data.get('type', '') == 'other'))
          && pressCardOk(o.get('card', ''));
      }
    }

    // ---------- уведомления (созывы, объявления) ----------
    match /notifications/{id} {
      // созывы и объявления видны всем (баннер на главной), новости — вошедшим.
      // v223: личные уведомления (назначение/снятие, поле to) — только адресату (логин {to}@vppka.local); владельцу — общее правило isSuper.
      allow get, list: if resource.data.type in ['convocation','other']
        || (signedIn() && resource.data.type == 'news')
        || (signedIn() && request.auth.token.email == resource.data.to + '@vppka.local');
      // тип проверяется первым: для личных уведомлений (appoint/recall) ключ не читается — экономит лимит обращений
      // v282: объявление как новость (дата, фото, видео, до 20000 знаков); пресс-служба — свои type=other.
      // source / discordMessageId / hidden — импорт из Discord (ставит бот; с сайта не задаются при создании).
      allow create: if request.resource.data.type in ['news','convocation','other']
        && request.resource.data.keys().hasOnly(['type','title','text','when','author','authorName','createdAt','place','at','pinned','hidden','date','photos','image','videos','card','updatedAt','source','discordMessageId'])
        && optStr(request.resource.data, 'authorName', 160)
        && noticeExtraOk(request.resource.data)
        && noticeMediaOk(request.resource.data)
        && (myTier() >= 4 || isChief() || pressNoticeOk())
        && reqStr(request.resource.data, 'title', 200)
        && optStr(request.resource.data, 'text', 20000) && optStr(request.resource.data, 'when', 100)
        && request.resource.data.author == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !('source' in request.resource.data) && !('discordMessageId' in request.resource.data);
      // Личное уведомление о назначении или снятии с руководящей должности.
      // Пишет только тот, кто вправе назначать; адресат — текущий держатель этой должности, не произвольный пользователь.
      function seatNoteOk() {
        let seat = /databases/$(database)/documents/members/$(request.resource.data.seat);
        let held = get(seat).data;
        return rankAdmin()
          && request.resource.data.keys().hasOnly(['type','title','text','author','authorName','createdAt','to','seat'])
          && request.resource.data.type in ['appoint','recall']
          && request.resource.data.author == request.auth.uid
          && request.resource.data.createdAt == request.time
          && reqStr(request.resource.data, 'title', 120)
          && reqStr(request.resource.data, 'text', 300)
          && optStr(request.resource.data, 'authorName', 160)
          && request.resource.data.to is string
          && request.resource.data.to.matches('^[0-9]{15,21}$')
          && request.resource.data.seat is string
          && request.resource.data.seat.matches('^[A-Za-z0-9_-]{1,40}$')
          && !request.resource.data.seat.matches('^p_.*')
          && request.resource.data.seat != 'm11'
          && held.get('discordId','') == request.resource.data.to
          && held.get('group','') != 'Члены партии'
          && held.get('role','') != 'Начальник технического отдела'
          // v222: тех. отдел и места владельца меняет только владелец
          && (isSuper() || (held.get('group','') != 'Технический отдел' && held.get('discordId','') != '646280678736003073'
              && !(request.resource.data.seat in ['m11','m12','m13','m14','m17'])))
          && (held.get('rank',0) < 100 || isSuper())
          && (request.resource.data.type == 'recall' || held.get('updatedBy','') == request.auth.uid);
      }
      allow create: if seatNoteOk();
      // v262: место и время события (окно «Объявления» на главной): place — до 120 символов, at — мс, 2020…2100 гг.
      function noticeExtraOk(d) {
        return optStr(d, 'place', 120)
          && (!('at' in d) || (d.at is int && d.at > 1577836800000 && d.at < 4102444800000))
          && (!('pinned' in d) || d.pinned is bool) && (!('hidden' in d) || d.hidden is bool);
      }
      function noticeMediaOk(d) {
        return (!('date' in d) || (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (!('card' in d) || (d.card is string && d.card.size() <= 128))
          && (!('source' in d) || d.source == 'discord')
          && optStr(d, 'discordMessageId', 32)
          && (!('photos' in d) || (d.photos is list && d.photos.size() <= 4
                && (d.photos.size() < 1 || newsImg(d.photos[0])) && (d.photos.size() < 2 || newsImg(d.photos[1]))
                && (d.photos.size() < 3 || newsImg(d.photos[2])) && (d.photos.size() < 4 || newsImg(d.photos[3]))))
          && (!('videos' in d) || (d.videos is list && d.videos.size() <= 5
                && (d.videos.size() < 1 || newsUrl(d.videos[0])) && (d.videos.size() < 2 || newsUrl(d.videos[1]))
                && (d.videos.size() < 3 || newsUrl(d.videos[2])) && (d.videos.size() < 4 || newsUrl(d.videos[3]))
                && (d.videos.size() < 5 || newsUrl(d.videos[4]))))
          && (!('image' in d) || newsImg(d.image));
      }
      function pressNoticeOk() {
        let d = request.resource.data;
        return d.type == 'other'
          && d.get('author', '') == request.auth.uid
          && (resource == null || resource.data.get('author', '') == request.auth.uid)
          && d.get('pinned', false) == (resource == null ? false : resource.data.get('pinned', false))
          && pressCardOk(d.get('card', ''));
      }
      // v262 / v282: публикующий (ступень 4+, isChief, пресс-служба — своё) правит объявление.
      allow update: if (myTier() >= 4 || isChief() || pressNoticeOk()) && resource.data.type in ['convocation','other']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','text','when','place','at','pinned','hidden','editedBy','editedAt','date','photos','image','videos','card','updatedAt','authorName'])
        && reqStr(request.resource.data, 'title', 200)
        && optStr(request.resource.data, 'text', 20000) && optStr(request.resource.data, 'when', 100)
        && noticeExtraOk(request.resource.data)
        && noticeMediaOk(request.resource.data)
        && optStr(request.resource.data, 'authorName', 160)
        && request.resource.data.editedBy == request.auth.uid
        && request.resource.data.editedAt == request.time
        && (myTier() >= 4 || isChief() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pinned','hidden']));
      allow update: if (myTier() >= 4 || isChief()) && resource.data.type == 'convocation'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelled','cancelledAt','reason'])
        && request.resource.data.cancelled == true
        && request.resource.data.cancelledAt == request.time
        && optStr(request.resource.data, 'reason', 500);
      allow delete: if myTier() >= 4 || isChief();
    }

    // ---------- заявки в партию ----------
    match /applications/{id} {
      function validAnswers(a) {
        return a is map
          && a.keys().hasOnly(['fio','passport','discord','source','reason','bio'])
          && a.keys().hasAll(['fio','passport','discord','source','reason','bio'])
          && reqStr(a, 'fio', 2000) && reqStr(a, 'passport', 2000) && reqStr(a, 'discord', 2000)
          && reqStr(a, 'source', 2000) && reqStr(a, 'reason', 2000) && optStr(a, 'bio', 4000);
      }
      // заявка с сайта: только вошедший, одна заявка на аккаунт (id документа = uid)
      allow create: if signedIn() && id == request.auth.uid && verified()
        && request.resource.data.keys().hasOnly(['answers','status','createdAt','uid','discordId'])
        && request.resource.data.keys().hasAll(['answers','status','createdAt','uid'])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && validAnswers(request.resource.data.answers)
        && request.resource.data.uid == request.auth.uid
        && optStr(request.resource.data, 'discordId', 64);
      // заявка из Discord (создаёт бот через служебный аккаунт владельца)
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['answers','status','createdAt','discordId','source','discordSourceId'])
        && request.resource.data.status == 'new' && request.resource.data.source == 'discord'
        && request.resource.data.createdAt == request.time
        && request.resource.data.answers is map
        && request.resource.data.answers.keys().hasOnly(['fio','passport','discord','source','reason','bio'])
        && reqStr(request.resource.data.answers, 'fio', 2000)
        && reqStr(request.resource.data, 'discordSourceId', 32)
        && optStr(request.resource.data, 'discordId', 64);
      allow read: if myTier() >= 3 || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
      // заявитель может удалить свою отклонённую или архивную (карточку удалили / уволен) заявку, чтобы подать новую
      allow delete: if signedIn() && id == request.auth.uid && resource.data.status in ['rejected','expelled'];
      function aChanged() { return request.resource.data.diff(resource.data).affectedKeys(); }
      // ступень заявителя: по ключу его аккаунта (нет аккаунта/ключа → 0)
      function targetTier() { return resource.data.get('uid', '') == '' ? 0 : userTier(resource.data.uid); }
      // рассмотреть заявку (принять/отклонить): ступень 3+
      function reviewOk() {
        return aChanged().hasOnly(['status','reviewedBy','reviewedAt','reviewerRole','rejectReason'])
          && myTier() >= 3
          && request.resource.data.status in ['new','accepted','rejected','member']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && optStr(request.resource.data, 'reviewerRole', 60)
          && optStr(request.resource.data, 'rejectReason', 500);
      }
      // повысить/понизить принятого члена партии: только Председатель ЦК, его заместители и владелец сайта
      function rankOk() {
        return aChanged().hasOnly(['partyRank','partyRole','rankedBy','rankedAt'])
          && rankAdmin() && rkTargetOk(resource.data.get('discordId', ''))
          && resource.data.status in ['accepted','member']
          && request.resource.data.get('partyRank', 0) is int
          && request.resource.data.get('partyRank', 0) >= 1 && request.resource.data.get('partyRank', 0) <= 5
          && request.resource.data.get('partyRole', '') == rkList()[request.resource.data.get('partyRank', 0) - 1]
          && request.resource.data.rankedBy == request.auth.uid
          && request.resource.data.rankedAt == request.time;
      }
      // увольнение из партии: ступень 5+, ступень цели ниже своей
      function expelOk() {
        return aChanged().hasOnly(['status','expelledBy','expelledAt'])
          && myTier() >= 5 && targetTier() < myTier()
          && resource.data.status in ['accepted','member'] && request.resource.data.status == 'expelled'
          && request.resource.data.expelledBy == request.auth.uid && request.resource.data.expelledAt == request.time;
      }
      // отметка о публикации заявки в Discord (ретранслятор владельца)
      function relayOk() { return isOwner() && aChanged().hasOnly(['discordPostedAt','discordMessageId','discordDecision']) && optStr(request.resource.data, 'discordMessageId', 32) && optStr(request.resource.data, 'discordDecision', 40); }
      allow update: if reviewOk() || rankOk() || relayOk() || expelOk();
      allow delete: if myRank() >= 100;
      // заявки удаляемого гостя: только новые/отклонённые, у заявителя нет ключа
      allow delete: if signedIn() && (isOwner() || myTier() >= 4)
        && resource.data.status in ['new','rejected','expelled'] && targetTier() == 0;
    }

    // ---------- история званий: видят члены партии, пишет ступень 4+ ----------
    match /rankHist/{id} {
      allow read: if isOwner() || partyMember() || myTier() >= 1;
      allow create: if (myTier() >= 4 || rankAdmin())
        && request.resource.data.keys().hasOnly(['did','kind','from','to','name','reason','by','byName','at'])
        && reqStr(request.resource.data, 'did', 64) && request.resource.data.kind in ['up','down','assign']
        && optStr(request.resource.data, 'from', 80) && optStr(request.resource.data, 'to', 80)
        && optStr(request.resource.data, 'name', 160) && optStr(request.resource.data, 'reason', 300)
        && optStr(request.resource.data, 'byName', 160)
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow delete: if isChief();   // v272: и Председатель ЦК, и замы
    }

    // ---------- внутрипартийные голосования ----------
    match /votes/{id} {
      function vPath() { return /databases/$(database)/documents/votes/$(id); }
      function validVote(d) {
        return d.keys().hasOnly(['title','type','desc','options','deadline','closed','createdBy','createdAt','counts','total','discordMessageId','discordChannelId'])
          && reqStr(d, 'title', 200) && d.type in ['decision','candidates','amendment']
          && optStr(d, 'desc', 4000) && d.options is list && d.options.size() >= 2 && d.options.size() <= 10
          && d.deadline is int && d.closed is bool && d.counts is map && d.total is int;
      }
      allow read: if isOwner() || partyMember() || myTier() >= 1;
      allow create: if myTier() >= 5 && validVote(request.resource.data)
        && request.resource.data.total == 0 && request.resource.data.closed == false
        && request.resource.data.counts.size() == request.resource.data.options.size();
      // правка/закрытие: ступень 5+, счётчики не трогает
      allow update: if myTier() >= 5 && validVote(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','desc','deadline','closed']);
      allow delete: if myTier() >= 5;
      // голос: член партии, один раз, +1 к одному варианту вместе с бюллетенем ballots/{uid}
      function bPath() { return /databases/$(database)/documents/votes/$(id)/ballots/$(request.auth.uid); }
      allow update: if (partyMember() || myTier() >= 1) && resource.data.closed == false && request.time.toMillis() < resource.data.deadline
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts','total'])
        && !exists(bPath()) && existsAfter(bPath())
        && request.resource.data.total == resource.data.total + 1
        && request.resource.data.counts.diff(resource.data.counts).affectedKeys() == [string(getAfter(bPath()).data.opt)].toSet()
        && request.resource.data.counts[string(getAfter(bPath()).data.opt)] == resource.data.counts[string(getAfter(bPath()).data.opt)] + 1;
      match /ballots/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || myTier() >= 4);
        allow list: if myTier() >= 4;
        allow create: if signedIn() && request.auth.uid == uid && (partyMember() || myTier() >= 1)
          && request.resource.data.keys().hasOnly(['opt','at','n'])
          && request.resource.data.opt is int && request.resource.data.opt >= 0
          && request.resource.data.opt < get(vPath()).data.options.size()
          && request.resource.data.at == request.time && optStr(request.resource.data, 'n', 120)
          && getAfter(vPath()).data.total == get(vPath()).data.total + 1;
        allow delete: if myTier() >= 5;
      }
    }

    // ---------- мероприятия: читают все, правит ступень 4+ ----------
    match /events/{id} {
      function validEv(d) {
        return d.keys().hasOnly(['title','at','place','desc','image','createdBy','updatedAt','discordMessageId','att','status','endedAt','endedBy','hidden','hiddenBy','hiddenAt'])
          && (!('hidden' in d) || d.hidden is bool)
          && (!('hiddenBy' in d) || (d.hiddenBy is string && d.hiddenBy.size() <= 128))
          && (!('hiddenAt' in d) || d.hiddenAt is timestamp)
          && (!('att' in d) || (d.att is list && d.att.size() <= 150))
          && (!('status' in d) || d.status == 'ended')
          && (!('endedBy' in d) || (d.endedBy is string && d.endedBy.size() > 0 && d.endedBy.size() <= 128))
          && (!('endedAt' in d) || d.endedAt is timestamp)
          && reqStr(d, 'title', 200) && d.at is int
          && optStr(d, 'place', 200) && optStr(d, 'desc', 4000) && optStr(d, 'image', 2000)
          && optStr(d, 'createdBy', 128) && optStr(d, 'discordMessageId', 32)
          && (!('updatedAt' in d) || d.updatedAt is int);
      }
      function evActor() {
        return isOwner() || myTier() >= 4
          || (signedIn() && resource.data.get('createdBy', '') == request.auth.uid);
      }
      function endOk() {
        return evActor()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endedAt','endedBy'])
          && request.resource.data.status == 'ended'
          && request.resource.data.endedBy == request.auth.uid
          && request.resource.data.endedAt == request.time;
      }
      function resumeOk() {
        return evActor()
          && (isChief() || !evLocked())
          && resource.data.get('status', '') == 'ended'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endedAt','endedBy'])
          && !('status' in request.resource.data)
          && !('endedAt' in request.resource.data)
          && !('endedBy' in request.resource.data);
      }
      allow read: if true;
      allow create: if myTier() >= 4 && validEv(request.resource.data);
      // v221: завершённое с отметками (evLocked) не «возобновить, стереть отметки, удалить» — снять статус может только владелец.
      function evLocked() { return resource.data.get('status', '') == 'ended' && resource.data.get('att', []).size() > 0; }
      allow update: if (myTier() >= 4 && validEv(request.resource.data)
          && !(resource.data.get('status', '') == 'ended'
               && request.resource.data.diff(resource.data).affectedKeys().hasAny(['att']))
          && (!evLocked() || request.resource.data.get('status', '') == 'ended' || isChief()))
        || endOk() || resumeOk();
      // v221: мероприятие с посещаемостью не пропадает бесследно.
      //  * завершённое с отметками — удаляет только владелец (остальным — «Скрыть», поле hidden);
      //  * ступень 4+ удаляет только вместе с копией в eventsArchive/{id} (та же пачка, копия — точный снимок);
      //  * без копии (старый код сайта) — только ещё не прошедшее и без отметок мероприятие (отмена плана).
      function evHasAtt() { return resource.data.get('att', []).size() > 0; }
      function evArchived() {
        return existsAfter(/databases/$(database)/documents/eventsArchive/$(id))
          && getAfter(/databases/$(database)/documents/eventsArchive/$(id)).data.by == request.auth.uid;
      }
      allow delete: if isChief()
        || (myTier() >= 4
            && !(resource.data.get('status', '') == 'ended' && evHasAtt())
            && (evArchived()
                || (!evHasAtt() && resource.data.get('status', '') != 'ended' && resource.data.at > request.time.toMillis())));
    }

    // ---------- v221: корзина мероприятий — неизменяемые копии удалённых; удаляет (в т.ч. при «Восстановить») только владелец ----------
    match /eventsArchive/{id} {
      allow read: if myTier() >= 4;
      allow create: if myTier() >= 4
        && request.resource.data.keys().hasOnly(['ev','by','at','title'])
        && request.resource.data.keys().hasAll(['ev','by','at','title'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/events/$(id))
        && request.resource.data.ev == get(/databases/$(database)/documents/events/$(id)).data
        && request.resource.data.title == get(/databases/$(database)/documents/events/$(id)).data.title
        && !existsAfter(/databases/$(database)/documents/events/$(id));
      allow update: if false;
      allow delete: if isChief();   // v272: и Председатель ЦК, и замы
    }

    // ---------- новости ----------
    match /news/{id} {
      // v227: ссылки в новостях — только https:// (свои фото: ph:<id>, data:image/…, img/…); javascript:, data:text/…, http: — отказ
      // newsUrl / newsImg — общие, выше (v282)
      function validNews(d) {
        // pushSent и discordMessageId ставит бот/рассылка; при правке с сайта их можно только сохранить как есть
        return d.keys().hasOnly(['title','text','image','photos','videos','date','author','createdAt','updatedAt','pinned','likeCount','align','pushSent','discordMessageId','card','source','hidden','authorName'])
          && (!('card' in d) || (d.card is string && d.card.size() <= 128))
          && (!('pushSent' in d) || (resource != null && d.pushSent == resource.data.get('pushSent', null)))
          && (!('discordMessageId' in d) || (resource != null && d.discordMessageId == resource.data.get('discordMessageId', null)))
          && (!('source' in d) || (d.source == 'discord' && resource != null && d.source == resource.data.get('source', null)))
          && (!('hidden' in d) || d.hidden is bool)
          && optStr(d, 'authorName', 160)
          && (!('align' in d) || d.align in ['center'])
          && (!('likeCount' in d) || d.likeCount is int)
          && (!('pinned' in d) || d.pinned is bool)
          && (!('photos' in d) || (d.photos is list && d.photos.size() <= 4
                && (d.photos.size() < 1 || newsImg(d.photos[0])) && (d.photos.size() < 2 || newsImg(d.photos[1]))
                && (d.photos.size() < 3 || newsImg(d.photos[2])) && (d.photos.size() < 4 || newsImg(d.photos[3]))))
          && (!('videos' in d) || (d.videos is list && d.videos.size() <= 5
                && (d.videos.size() < 1 || newsUrl(d.videos[0])) && (d.videos.size() < 2 || newsUrl(d.videos[1]))
                && (d.videos.size() < 3 || newsUrl(d.videos[2])) && (d.videos.size() < 4 || newsUrl(d.videos[3]))
                && (d.videos.size() < 5 || newsUrl(d.videos[4]))))
          && (!('image' in d) || newsImg(d.image))
          && reqStr(d, 'title', 200) && reqStr(d, 'text', 20000)
          && d.get('date', '') is string && d.get('date', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && optStr(d, 'image', 900000)
          && (!('author' in d) || d.author == request.auth.uid || (resource != null && d.author == resource.data.get('author', null)));
      }
      allow read: if true;
      // новости (с фото и видео): ступень 4+; v272: и Председатель ЦК с замами (isChief)
      // v272: «Начальник пресс-службы» создаёт свои новости и правит только свои (author = он, card — его карточка с доп. должностью);
      // закреплять (pinned) не может, чужие не правит и не удаляет.
      function pressNewsOk() {
        let d = request.resource.data;
        return d.get('author', '') == request.auth.uid
          && (resource == null || resource.data.get('author', '') == request.auth.uid)
          && d.get('pinned', false) == (resource == null ? false : resource.data.get('pinned', false))
          && validNews(d)
          && pressCardOk(d.get('card', ''));
      }
      allow create, update: if (myTier() >= 4 && validNews(request.resource.data)) || pressNewsOk()
        || (isChief() && validNews(request.resource.data));
      allow delete: if myTier() >= 4 || isChief();
      // лайк: вошедший меняет только likeCount на ±1 вместе со своим документом likes/{uid}
      function likePath() { return /databases/$(database)/documents/news/$(id)/likes/$(request.auth.uid); }
      // v258: лайкать может только аккаунт с подтверждённым Discord (не «голый» email-аккаунт)
      allow update: if linked() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount is int
        && ((!exists(likePath()) && existsAfter(likePath()) && request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1)
            || (exists(likePath()) && !existsAfter(likePath()) && request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1));
      match /likes/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow create: if linked() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid','t']) && request.resource.data.uid == uid && request.resource.data.t == request.time
          && getAfter(/databases/$(database)/documents/news/$(id)).data.get('likeCount', 0) == get(/databases/$(database)/documents/news/$(id)).data.get('likeCount', 0) + 1;
        allow delete: if linked() && request.auth.uid == uid
          && getAfter(/databases/$(database)/documents/news/$(id)).data.get('likeCount', 0) == get(/databases/$(database)/documents/news/$(id)).data.get('likeCount', 0) - 1;
      }
    }

    // ---------- состав / руководство ----------
    match /members/{id} {
      function validMember(d) {
        return d.keys().hasOnly(['name','role','group','photo','bio','quote','joined','birth','city','achievements',
                                 'discord','forum','contact','rank','order','updatedBy','updatedAt','discordId','tier','reportsTo','duties',
                                 'subPositions','awards'])
          && optStr(d, 'reportsTo', 120)
          && (!('duties' in d) || (d.duties is list && d.duties.size() <= 12))
          && d.get('tier', 0) is int && d.get('tier', 0) >= 0 && d.get('tier', 0) <= 9
          && reqStr(d, 'name', 100) && optStr(d, 'role', 120) && optStr(d, 'group', 80)
          && optStr(d, 'photo', 900000) && optStr(d, 'bio', 5000) && optStr(d, 'quote', 500)
          && optStr(d, 'joined', 60) && optStr(d, 'birth', 60) && optStr(d, 'city', 100)
          && optStr(d, 'achievements', 5000) && optStr(d, 'discord', 200) && optStr(d, 'forum', 300)
          && optStr(d, 'contact', 200) && optStr(d, 'discordId', 64)
          && d.get('rank', -1) is int && d.rank >= 0
          && (!('order' in d) || d.order is number)
          && (!('updatedBy' in d) || d.updatedBy == request.auth.uid);
      }
      // v271: доп. должности (руководство: владелец, m1, m4, m5) и награды (только владелец).
      function subPosList() {
        return ['Начальник пресс-службы', 'Пресс-секретарь', 'Корреспондент', 'Редактор новостей', 'Агитатор'];
      }
      // Владелец, Председатель ЦК (m1) и заместители Председателя ЦК (m4, m5). Не m12 и не Discord-роли.
      function subPosAdmin() { return isChief(); }
      function subPosShape(xs) {
        return xs is list && xs.size() <= 5 && xs.size() == xs.toSet().size()
          && xs.toSet().difference(subPosList().toSet()).size() == 0;
      }
      // Дешёвые проверки идут первыми: обычные правки сразу выходят из ветки, не тратя обращения к документам.
      // Ветка срабатывает только когда список доп. должностей изменился; остальные поля — без изменений.
      function subPosWriteOk() {
        return request.resource.data.get('subPositions', []) != resource.data.get('subPositions', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subPositions', 'updatedBy', 'updatedAt'])
          && request.resource.data.get('updatedBy', '') == request.auth.uid
          && subPosShape(request.resource.data.get('subPositions', null))
          && subPosAdmin() && extraTargetOk();
      }
      // v275: админ сайта (m13) не выдаёт награды/доп. должности себе и местам техотдела/владельца; руководство и владелец — как раньше.
      function extraTargetOk() {
        let vd = myVDid();
        return isOwner() || chiefDid(vd)
          || (!lockedId() && !lockedData(resource.data) && resource.data.get('discordId', '') != vd);
      }
      function medalIds() { return ['oct-109']; }
      function awardOk(a) {
        return a is map
          && a.keys().hasOnly(['medal', 'head', 'coverTo', 'title', 'years', 'date', 'no', 'basis', 'grant', 'note', 'image', 'spread', 'full', 'cert'])
          && a.get('medal', '') in medalIds()
          && a.get('title', null) is string && a.title.size() > 0 && a.title.size() <= 200
          && a.get('head', null) is string && a.head.size() <= 80
          && a.get('coverTo', null) is string && a.coverTo.size() <= 80
          && a.get('years', null) is string && a.years.size() <= 40
          && a.get('date', null) is string && a.date.matches('^[0-9]{2}[.][0-9]{2}[.][0-9]{4}$')
          && a.get('no', null) is string && a.no.size() > 0 && a.no.size() <= 12
          && a.get('basis', null) is string && a.basis.size() <= 200
          && a.get('image', '') == 'img/demo/medal-109.webp'
          && a.get('spread', '') == 'img/awards/m11-109.webp'
          && a.get('cert', false) == true && a.get('full', false) == true
          && (!('grant' in a) || (a.grant is string && a.grant.size() <= 400))
          && (!('note' in a) || (a.note is string && a.note.size() <= 300));
      }
      function awardsOk(xs) {
        return xs is list && xs.size() <= 4
          && (xs.size() < 1 || awardOk(xs[0]))
          && (xs.size() < 2 || (awardOk(xs[1]) && xs[1].medal != xs[0].medal))
          && (xs.size() < 3 || (awardOk(xs[2]) && xs[2].medal != xs[0].medal && xs[2].medal != xs[1].medal))
          && (xs.size() < 4 || (awardOk(xs[3]) && xs[3].medal != xs[0].medal && xs[3].medal != xs[1].medal && xs[3].medal != xs[2].medal));
      }
      // v272: награды выдают и отзывают владелец, Председатель ЦК и его замы.
      function awardWriteOk() {
        return request.resource.data.get('awards', []) != resource.data.get('awards', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['awards', 'updatedBy', 'updatedAt'])
          && request.resource.data.get('updatedBy', '') == request.auth.uid
          && awardsOk(request.resource.data.get('awards', null))
          && isChief() && extraTargetOk();
      }
      // Прежние ветки правки не трогают эти поля. Исключение — смена человека на месте руководства
      // (назначение / «Снять с должности»): доп. должности и награды принадлежат человеку, место их не наследует,
      // клиент пишет место без них — поля просто убираются.
      function extrasKept() {
        return (request.resource.data.get('subPositions', []) == resource.data.get('subPositions', [])
            && request.resource.data.get('awards', []) == resource.data.get('awards', []))
          || (!id.matches('^p_.*')
            && !('subPositions' in request.resource.data) && !('awards' in request.resource.data)
            && (request.resource.data.get('discordId', '') != resource.data.get('discordId', '')
                || request.resource.data.get('name', '') != resource.data.get('name', '')));
      }
      // v236: Discord (discordId/discord) — только членам партии и руководству; гостям и беспартийным — зеркало membersPub (пишет бот)
      allow read: if partyMember() || isOwner() || rankAdmin();
      // ступень 4+: добавлять/повышать/понижать записи со ступенью ниже своей (tier записи = ступень ключа человека, нет → 0);
      // ранг 100 (председатель) назначает только владелец
      // v272: руководство (m1, m4, m5) добавляет карточки любой ступени до 6 включительно, ранг ниже 100.
      function chiefCreateOk() {
        let d = request.resource.data;
        return (chiefDid(myVDid()) || (siteAdmDid(myVDid()) && d.get('discordId', '') != myVDid())) && validMember(d)
          && d.get('tier', 0) is int && d.get('tier', 0) >= 0 && d.get('tier', 0) <= 6 && d.rank < 100
          && d.get('updatedBy', '') == request.auth.uid;
      }
      function tierEdit(d) {
        return myTier() >= 4 && validMember(d) && d.get('tier', 0) < myTier()
          && d.rank < (isOwner() ? 1000 : 100);
      }
      // Место начальника техотдела и пост председателя (ранг 100) не переназначают замы и председатель.
      function techSeat() {
        return id == 'm11' || resource.data.get('role', '') == 'Начальник технического отдела';
      }
      function techRoleNew() {
        return request.resource.data.get('role', '') == 'Начальник технического отдела' || id == 'm11';
      }
      // Карточка «Члены партии» только с id p_<...>. Вторая карточка на то же ФИО блокируется memClaim/{имя}.
      function partyIdOk() {
        return !(request.resource.data.get('group', '') == 'Члены партии' || id.matches('^p_.*'))
          || (id.matches('^p_[A-Za-z0-9_-]{8,128}$') && request.resource.data.group == 'Члены партии');
      }
      function claimPath() {
        return /databases/$(database)/documents/memClaim/$(request.resource.data.name);
      }
      function partyClaimOk() {
        return request.resource.data.get('group', '') != 'Члены партии'
          || (existsAfter(claimPath())
              && getAfter(claimPath()).data.memberId == id
              && getAfter(claimPath()).data.name == request.resource.data.name);
      }
      // Новая вакансия руководства: председатель, замы, начальник техотдела (и владелец). Не членская карточка и не пост m11.
      function vacCreateOk() {
        return rankAdmin() && validMember(request.resource.data) && !techRoleNew()
          && request.resource.data.name == 'Вакансия'
          && request.resource.data.get('group', '') != ''
          && request.resource.data.get('group', '') != 'Члены партии'
          && request.resource.data.rank is int && request.resource.data.rank >= 0 && request.resource.data.rank < 100
          && request.resource.data.get('tier', 0) is int && request.resource.data.get('tier', 0) >= 0 && request.resource.data.get('tier', 0) <= 5
          && request.resource.data.get('discordId', '') == ''
          && request.resource.data.get('updatedBy', '') == request.auth.uid
          && !id.matches('^p_.*');
      }
      // v222 «только 7 доступ имеет право менять тех отдел»: места группы «Технический отдел» (m11–m14), m17 и любое место
      // с Discord ID владельца назначает, снимает и меняет только владелец (ему всё даёт общее правило isSuper внизу).
      // Держатель такого места может менять только своё фото (selfPhotoOk).
      function lockedId() { return id in ['m11','m12','m13','m14','m17']; }
      function lockedData(d) {
        return d.get('group', '') == 'Технический отдел' || d.get('discordId', '') == '646280678736003073'
          || d.get('role', '') == 'Начальник технического отдела';
      }
      // Одна дешёвая проверка для update (лимит 1000 выражений): место не закрыто ни до, ни после правки.
      // Заменяет techSeat()/techRoleNew() и бывшее ограничение td (m12 не меняет своё место и места владельца).
      function lockFree() {
        let o = resource.data;
        let n = request.resource.data;
        return !lockedId()
          && o.get('group', '') != 'Технический отдел' && n.get('group', '') != 'Технический отдел'
          && o.get('discordId', '') != '646280678736003073' && n.get('discordId', '') != '646280678736003073'
          && o.get('role', '') != 'Начальник технического отдела' && n.get('role', '') != 'Начальник технического отдела';
      }
      allow create: if !lockedId() && !lockedData(request.resource.data)
        && !('subPositions' in request.resource.data) && !('awards' in request.resource.data)
        && partyIdOk() && partyClaimOk() && !techRoleNew() && (chiefCreateOk() || tierEdit(request.resource.data) || vacCreateOk());
      // назначение человека на должность (смена discordId): владелец и ступень 5, как раньше
      function assignOk() { return request.resource.data.get('discordId', '') == resource.data.get('discordId', '') || myTier() >= 5; }
      // звание (role) записи «Члены партии» (p_*) — только распорядители званий
      function rkKeep() { return !id.matches('^p_.*') || request.resource.data.get('role', '') == resource.data.get('role', '') || rankAdmin(); }
      function sameSeat(k) { return request.resource.data.get(k, null) == resource.data.get(k, null); }
      // Назначение на уже существующую руководящую должность без смены роли, ранга и ступени.
      // Могут: председатель ЦК (m1), его заместители (m4, m5), начальник техотдела и владелец (rankAdmin).
      function deputySeat() { return id == 'm4' || id == 'm5'; }
      // Смена человека на месте зама — только председатель (m1) или владелец.
      function deputyReassign() {
        return deputySeat() && !chairNow()
          && (request.resource.data.get('discordId', '') != resource.data.get('discordId', '')
              || request.resource.data.get('name', '') != resource.data.get('name', ''));
      }
      // ВАЖНО: у правил Firestore лимит 1000 вычисленных выражений и 10 обращений к документам на запрос.
      // Права (владелец, распорядитель, председатель) считаются один раз и передаются аргументами,
      // а тяжёлая validMember() вызывается только в ветке, где без неё нельзя. Иначе у не-владельца
      // (председатель, замы) любое назначение/снятие/смена звания отклонялись по лимиту.
      // Назначение/снятие на существующей руководящей должности без смены роли, ранга, ступени и порядка.
      // Меняются только человек (name, discordId, discord, joined, bio, photo); остальное — как в документе.
      // td — заместитель начальника техотдела (m12), если он не занимает m1/m4/m5: своё место m12
      // и места, которые занимает владелец (m11, m17), он не меняет.
      function seatAssignOk(ra, chair, td) {
        let d = request.resource.data;
        return ra
          && !(td && (id == 'm12' || resource.data.get('discordId', '') == '646280678736003073'))
          && !id.matches('^p_.*')
          && resource.data.get('group', '') != 'Члены партии'
          && resource.data.get('rank', 0) < 100
          && (!deputySeat() || chair)
          // нет поля tier = ступень 0 (форма админки дописывает tier: 0 у старых вакансий)
          && d.keys().hasOnly(['name','bio','discord','discordId','joined','photo','updatedBy','updatedAt',
                               'role','group','rank','tier','order','reportsTo','duties','subPositions','awards'])
          && d.get('updatedBy', '') == request.auth.uid
          && sameSeat('role') && sameSeat('group') && sameSeat('rank') && d.get('tier', 0) == resource.data.get('tier', 0)
          && sameSeat('order') && sameSeat('reportsTo') && sameSeat('duties')
          && reqStr(d, 'name', 100) && optStr(d, 'discordId', 64) && optStr(d, 'discord', 200)
          && optStr(d, 'joined', 60) && optStr(d, 'bio', 5000) && optStr(d, 'photo', 900000);
      }
      // смена звания карточки p_*: только поле role (+ updatedBy/updatedAt), значение из списка званий, не у распорядителей
      function rankChangeOk(ra) {
        return ra && id.matches('^p_.*')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','updatedBy','updatedAt'])
          && resource.data.get('role', '') in rkList() && request.resource.data.get('role', '') in rkList()
          && request.resource.data.get('updatedBy', '') == request.auth.uid
          && rkTargetOk(resource.data.get('discordId', ''));
      }
      // автофото: владелец привязанной записи (discordId совпадает с логином, аккаунт подтверждён кодом из Discord) меняет только своё фото
      function selfPhotoOk() {
        return resource.data.get('discordId', '') != ''
          && request.auth.token.email == resource.data.discordId + '@vppka.local'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo','updatedBy','updatedAt'])
          && optStr(request.resource.data, 'photo', 900000)
          && (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == request.auth.uid)
          && verified();
      }
      // v224 «О себе»: человек на своей записи (discordId = логин, подтверждённый аккаунт) меняет только bio (до 1500 символов).
      // v254: и «Цитату» — quote (до 500 символов, как в validMember).
      // Стоит последней веткой update (вне updEntry) — у правок руководства не съедает лимит 1000 выражений.
      function selfBioOk() {
        return resource.data.get('discordId', '') != ''
          && request.auth.token.email == resource.data.discordId + '@vppka.local'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bio','quote','updatedBy','updatedAt'])
          && optStr(request.resource.data, 'bio', 1500) && optStr(request.resource.data, 'quote', 500)
          && (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == request.auth.uid)
          && verified();
      }
      // ступень 4+: запись со ступенью ниже своей; смена человека (discordId) — ступень 5+; звание p_* — распорядители и только из rkList()
      function tierUpdOk(t, own, ra) {
        let lim = own ? 1000 : 100;
        return t >= 4
          && resource.data.get('tier', 0) < t && resource.data.rank < lim
          && (request.resource.data.get('discordId', '') == resource.data.get('discordId', '') || t >= 5)
          && request.resource.data.get('tier', 0) is int && request.resource.data.get('tier', 0) < t
          && request.resource.data.get('rank', -1) is int && request.resource.data.rank < lim
          && (!id.matches('^p_.*') || request.resource.data.get('role', '') == resource.data.get('role', '')
              || (ra && request.resource.data.get('role', '') in rkList()))
          && validMember(request.resource.data);
      }
      // председатель: только правка полей, ранг и ступень менять нельзя, удалять нельзя
      function chairEditOk() {
        return resource.data.rank == 100 && request.resource.data.get('rank', -1) == resource.data.rank
          && request.resource.data.get('tier', 0) == resource.data.get('tier', 0)
          && canChair() && validMember(request.resource.data);
      }
      // смена человека на месте зама (m4/m5) — только председатель (m1) или владелец
      function deputyReassignP(chair) {
        return deputySeat() && !chair
          && (request.resource.data.get('discordId', '') != resource.data.get('discordId', '')
              || request.resource.data.get('name', '') != resource.data.get('name', ''));
      }
      // v272: Председатель ЦК и замы правят любую карточку (и p_*, любой ступени), кроме мест техотдела/владельца (lockFree снаружи).
      // Ранг 100 (пост председателя) и ступени 7+ (админские) не выставляют; у карточки ранга 100 ранг и ступень не меняются;
      // человека на m1 меняет только владелец, на m4/m5 — председатель (deputyReassignP в updEntry).
      function chiefEditOk(vd) {
        let o = resource.data;
        let n = request.resource.data;
        let personChg = n.get('discordId', '') != o.get('discordId', '') || n.get('name', '') != o.get('name', '');
        return (chiefDid(vd) || (siteAdmDid(vd) && o.get('discordId', '') != vd && n.get('discordId', '') != vd))
          && (!personChg || !(id in ['m4', 'm5']) || vd == seatDid('m1'))
          && n.get('tier', 0) is int && n.get('tier', 0) >= 0 && n.get('tier', 0) <= 6
          && (o.get('rank', 0) < 100
              ? (n.get('rank', -1) is int && n.get('rank', -1) < 100)
              : (n.get('rank', -1) == o.get('rank', 0) && n.get('tier', 0) == o.get('tier', 0)))
          && (id != 'm1' || (n.get('discordId', '') == o.get('discordId', '') && n.get('name', '') == o.get('name', '')))
          && (!id.matches('^p_.*') || n.get('role', '') == o.get('role', '') || n.get('role', '') in rkList())
          && validMember(n);
      }
      function updEntry(own, vd) {
        let ra = own || (vd != '' && vd in rkAdminDids());
        let chair = own || (deputySeat() && vd != '' && vd == seatDid('m1'));
        // v222: td (m12) больше не нужен — места тех. отдела и владельца закрыты lockFree()
        // v275: админ сайта (m13) своё место и свои карточки не меняет (кроме своего фото) и себя никуда не назначает
        let selfT = !own && siteAdmDid(vd) && (resource.data.get('discordId', '') == vd || request.resource.data.get('discordId', '') == vd);
        return !deputyReassignP(chair)
          && ((!selfT && (seatAssignOk(ra, chair, false) || rankChangeOk(ra)
              || tierUpdOk(own ? 9 : keyTier(), own, ra) || chairEditOk())) || selfPhotoOk());
      }
      // v271: прежние ветки правки не меняют subPositions и awards (extrasKept, проверяется один раз; см. исключение там);
      // эти поля меняют только subPosWriteOk() (руководство) и awardWriteOk() (владелец). Shape проверяется там же,
      // поэтому validMember() их только пропускает (без дорогой проверки — лимит 1000 выражений).
      allow update: if (extrasKept() && lockFree() && chiefEditOk(myVDid()))
        || (extrasKept() && ((lockFree() && updEntry(isOwner(), myVDid()))
        || ((lockedId() || lockedData(resource.data)) && selfPhotoOk())
        || selfBioOk()))
        || subPosWriteOk() || awardWriteOk();
      // m1, m4 и m5 не удаляет никто, кроме владельца (ему это даёт общее правило isSuper).
      // Занятое руководящее место не удаляется: его освобождают, имя становится «Вакансия». Карточки «Члены партии» удаляются как раньше.
      allow delete: if !techSeat() && !lockedId() && !lockedData(resource.data) && !(id in ['m1', 'm4', 'm5', 'm12']) && resource.data.get('rank', 0) < 100
        && (id.matches('^p_.*') || resource.data.get('group', '') == 'Члены партии'
            || (resource.data.get('name', '') is string && (resource.data.get('name', '') == 'Вакансия' || resource.data.get('name', '').lower() == 'вакансия')))
        && !(resource.data.get('discordId', '') != '' && siteAdmDid(myVDid()) && resource.data.get('discordId', '') == myVDid())
        && ((myTier() >= 4 && resource.data.get('tier', 0) < myTier() && resource.data.rank < (isOwner() ? 1000 : 100))
            || (rankAdmin() && !id.matches('^p_.*') && resource.data.get('group', '') != 'Члены партии')
            || isChief());
    }
    // v236: публичная копия состава без Discord (discord, discordId, updatedBy убраны; pk — псевдо-ID для группировки,
    // skin-ID владельца). Ведёт только бот (сервисный аккаунт). Гости и не члены партии читают её вместо members.
    match /membersPub/{id} {
      allow read: if true;
      allow write: if false;
    }
    // Замок от второй карточки члена партии с тем же ФИО. Создаётся вместе с members/p_* одной пачкой.
    // Правка и удаление уже существующей карточки замок не требуют: старые карточки его не имеют.
    match /memClaim/{key} {
      function claimCard(mid) { return /databases/$(database)/documents/members/$(mid); }
      function claimShape() {
        return (myTier() >= 4 || rankAdmin())
          && key == request.resource.data.name
          && request.resource.data.keys().hasOnly(['name','memberId','by'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
          && request.resource.data.memberId is string && request.resource.data.memberId.matches('^p_[A-Za-z0-9_-]{8,128}$')
          && request.resource.data.by == request.auth.uid
          && existsAfter(claimCard(request.resource.data.memberId))
          && getAfter(claimCard(request.resource.data.memberId)).data.name == request.resource.data.name
          && getAfter(claimCard(request.resource.data.memberId)).data.group == 'Члены партии';
      }
      // Чужой живой замок не переписываем. Можно обновить свой или занять ФИО, если прежняя карточка уже удалена.
      function claimFree() {
        return resource.data.memberId == request.resource.data.memberId
          || !exists(claimCard(resource.data.memberId))
          || get(claimCard(resource.data.memberId)).data.get('group', '') != 'Члены партии'
          || get(claimCard(resource.data.memberId)).data.get('name', '') != resource.data.get('name', '');
      }
      allow get: if signedIn();
      allow list: if isSuper() || myTier() >= 4 || rankAdmin();
      allow create: if claimShape();
      allow update: if claimShape() && claimFree();
      allow delete: if isSuper() || myTier() >= 4 || rankAdmin();
    }

    // ---------- увольнения: id = discordId; отметку и причину видят только ступень 4+ и владелец ----------
    match /expulsions/{did} {
      allow read: if myTier() >= 4;
      allow create, update: if myTier() >= 5
        && request.resource.data.keys().hasOnly(['name','reason','by','at'])
        && reqStr(request.resource.data, 'name', 100) && optStr(request.resource.data, 'reason', 500)
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow delete: if myTier() >= 5;
    }

    // ---------- личные сообщения ----------
    // Публичный справочник для поиска собеседников: имя, миниатюра, Discord. Владелец и служебный аккаунт сюда не пишутся.
    match /pub/{uid} {
      allow read: if linked();   // v258: справочник собеседников — только аккаунтам с подтверждённым Discord
      allow create, update: if signedIn() && (request.auth.uid == uid || isOwner() || myTier() >= 5)
        && uid != 'ZpVGAXbbg1a9I8kRsNEm0OU8QAt2'
        && !(uid in get(/databases/$(database)/documents/config/owners).data.uids)
        && request.resource.data.keys().hasOnly(['n','ph','did','t'])
        && reqStr(request.resource.data, 'n', 40) && optStr(request.resource.data, 'did', 64)
        // did своего справочника = Discord ID из логина (нельзя выдать себя за другого)
        && (request.auth.uid != uid || (request.resource.data.get('did', '') == request.auth.token.email.split('@')[0] && verified()))
        && (!('ph' in request.resource.data) || (request.resource.data.ph is string && (request.resource.data.ph.size() <= 30000 && request.resource.data.ph.matches('^data:image/jpeg;base64,.*') || request.resource.data.ph.size() <= 100000 && request.resource.data.ph.matches('^data:image/gif;base64,.*'))));
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner() || myTier() >= 5);
    }
    // rankNotes: системный раздел чата «Повышения и понижения». Цель — по Discord ID (did).
    match /rankNotes/{id} {
      function myDid() { return request.auth.token.email.split('@')[0]; }
      allow read: if verified() && request.auth.token.email is string && resource.data.did == myDid();
      allow update: if verified() && request.auth.token.email is string && resource.data.did == myDid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read == true;
      allow create: if signedIn() && (myTier() >= 4 || rankAdmin())
        && request.resource.data.keys().hasOnly(['did','kind','text','by','byName','at','read'])
        && request.resource.data.did is string && request.resource.data.did.size() > 0 && request.resource.data.did.size() <= 64
        && request.resource.data.did != myDid()
        && request.resource.data.kind in ['up','down','assign']
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 160
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
        && request.resource.data.read == false;
      allow delete: if isChief();   // v272: и Председатель ЦК, и замы
    }
    // chats/{a_b}: participants = [a,b] (по возрастанию), id = a_b
    match /chats/{chatId} {
      function owners() { return get(/databases/$(database)/documents/config/owners).data.uids; }
      function isPart() { return signedIn() && request.auth.uid in resource.data.participants; }
      function okUnread(d) { return d.unread is map && d.unread.keys().hasOnly(d.participants)
        && d.unread[d.participants[0]] is int && d.unread[d.participants[1]] is int; }
      function okLast(d) { return d.lastMessage is map && d.lastMessage.keys().hasOnly(['text','from','at'])
        && d.lastMessage.text is string && d.lastMessage.text.size() <= 2000
        && d.lastMessage.from == request.auth.uid && d.lastMessage.at == request.time; }
      allow read: if isPart() || (signedIn() && request.auth.uid == 'ZpVGAXbbg1a9I8kRsNEm0OU8QAt2');
      allow create: if verified() && request.resource.data.keys().hasOnly(['participants','createdBy','updatedAt','lastMessage','unread','names'])
        && request.resource.data.participants is list && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && !('ZpVGAXbbg1a9I8kRsNEm0OU8QAt2' in request.resource.data.participants)
        // со скрытым владельцем может начать переписку только он сам
        && (isOwner() || !(request.resource.data.participants[0] in owners() || request.resource.data.participants[1] in owners()))
        && okUnread(request.resource.data) && okLast(request.resource.data)
        && (!('names' in request.resource.data) || (isOwner() && request.resource.data.names is map
            && request.resource.data.names.keys().hasOnly([request.auth.uid]) && request.resource.data.names[request.auth.uid] is string
            && request.resource.data.names[request.auth.uid].size() <= 40));
      allow update: if isPart()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastMessage','unread'])
        && okUnread(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage','updatedAt'])
            || (okLast(request.resource.data) && request.resource.data.updatedAt == request.time));
      allow delete: if false;
      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if verified() && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.keys().hasOnly(['from','text','at'])
          && request.resource.data.from == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // pushSubs/{uid}: подписки на push-уведомления; пишет только владелец, читает только служебный аккаунт
    match /pushSubs/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == 'ZpVGAXbbg1a9I8kRsNEm0OU8QAt2');
      // v258: свою подписку пишет только аккаунт с подтверждённым Discord; служебный аккаунт — как раньше (только update)
      allow create, update: if signedIn() && ((request.auth.uid == uid && linked()) || (request.method == 'update' && request.auth.uid == 'ZpVGAXbbg1a9I8kRsNEm0OU8QAt2')) && request.resource.data.keys().hasOnly(['subs','t'])
        && request.resource.data.subs is map && request.resource.data.subs.size() <= 10;
      allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == 'ZpVGAXbbg1a9I8kRsNEm0OU8QAt2');
    }

    // meta/site {version}: версия сайта для мгновенного автообновления; читают все, пишет только admin SDK
    match /meta/{d} {
      allow get: if d == 'site';
      allow list, write: if false;
    }
    // banners/{uid}: баннер профиля. Либо url (https .mp4/.webm), либо файл частями в chunks/{ver_i}. Видят все, меняет только владелец.
    // музыка профиля (v256: у каждого вошедшего с привязанным Discord — своя, одна на аккаунт): читают все, пишет сам или владелец
    // файл до 10 МБ (10485760) — до 16 частей по 900000 символов base64; тип audio/*; ссылка YouTube хранится в url (https)
    // v256: части — в двух слотах a/b (chunks/{a|b}_{0..15}), новый файл пишется в свободный слот, старый удаляется → не больше 32 частей на аккаунт.
    // mid — своя карточка: её discordId должен совпадать с логином ({discordId}@vppka.local); name — только вместе с mid.
    function musByMe(uid) { return verified() && request.auth.uid == uid && request.auth.token.email is string; }
    function musCardOk(d) {
      return !('mid' in d) ? !('name' in d)
        : (d.mid is string && d.mid.matches('^[A-Za-z0-9_-]{1,64}$') && exists(/databases/$(database)/documents/members/$(d.mid))
           && (isOwner() || get(/databases/$(database)/documents/members/$(d.mid)).data.get('discordId', '') == request.auth.token.email.split('@')[0]));
    }
    match /ldrMusic/{uid} {
      allow read: if true;
      allow create, update: if (musByMe(uid) || isOwner())
        && request.resource.data.keys().hasOnly(['name','title','t','url','ver','n','mime','size','mid','sl'])
        && musCardOk(request.resource.data)
        && optStr(request.resource.data, 'name', 160) && optStr(request.resource.data, 'title', 100)
        && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 600 && request.resource.data.url.matches('^https://[^ ]+$')))
        && (!('n' in request.resource.data) || (request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 16))
        && (!('mime' in request.resource.data) || (request.resource.data.mime is string && request.resource.data.mime.matches('^audio/(mpeg|ogg|mp4|aac|wav|webm|flac)$')))
        && (!('size' in request.resource.data) || (request.resource.data.size is int && request.resource.data.size <= 10485760))
        && (!('ver' in request.resource.data) || (request.resource.data.ver is string && request.resource.data.ver.size() <= 20))
        && (!('sl' in request.resource.data) || request.resource.data.sl in ['a','b']);
      allow delete: if signedIn() && (request.auth.uid == uid || isChief());
      match /chunks/{cid} {
        allow read: if true;
        allow create, update: if (musByMe(uid) || isOwner())
          && cid.matches('^[ab]_([0-9]|1[0-5])$')
          && request.resource.data.keys().hasOnly(['d']) && request.resource.data.d is string && request.resource.data.d.size() <= 900000;
        // удалить можно и старые части вида {ver}_{i} (до v256)
        allow delete: if signedIn() && (request.auth.uid == uid || isChief());
      }
    }
    // v258: части баннера — в двух слотах a/b (chunks/{a|b}_{0..12}), как у музыки: новый файл пишется в свободный слот,
    // старый удаляется → не больше 26 частей на аккаунт. Старые части вида {ver}_{i} (до v258) можно только читать и удалять;
    // баннер-файл без sl (старый) показывается как раньше, новый файл без sl не записать.
    match /banners/{uid} {
      allow read: if true;
      allow create, update: if verified() && request.auth.uid == uid && request.auth.token.email is string
        && request.resource.data.keys().hasOnly(['url','did','t','kind','mime','n','size','ver','sl'])
        && request.resource.data.did == request.auth.token.email.split('@')[0]
        && request.resource.data.t == request.time
        && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 600
            && request.resource.data.url.matches('^https://[^ ]+[.](mp4|webm)([?#].*)?$')))
        && (!('kind' in request.resource.data) || request.resource.data.kind in ['video','image'])
        && (!('mime' in request.resource.data) || request.resource.data.mime in ['video/mp4','video/webm','image/gif','image/jpeg','image/png','image/webp'])
        && (!('n' in request.resource.data) || (request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 13
            && request.resource.data.get('sl', '') in ['a','b']))
        && (!('sl' in request.resource.data) || request.resource.data.sl in ['a','b'])
        && (!('size' in request.resource.data) || (request.resource.data.size is int && request.resource.data.size <= 8388608))
        && (!('ver' in request.resource.data) || (request.resource.data.ver is string && request.resource.data.ver.size() <= 20));
      allow delete: if signedIn() && (request.auth.uid == uid || isChief());
      match /chunks/{cid} {
        allow read: if true;
        allow create, update: if verified() && request.auth.uid == uid
          && cid.matches('^[ab]_([0-9]|1[0-2])$')
          && request.resource.data.keys().hasOnly(['d'])
          && request.resource.data.d is string && request.resource.data.d.size() <= 900000;
        // удалить можно и старые части вида {ver}_{i} (до v258)
        allow delete: if signedIn() && (request.auth.uid == uid || isChief());
      }
    }
    // avatars/{uid}: полноразмерная аватарка для больших профилей; видят вошедшие, меняет только сам пользователь
    // запрос синхронизации профиля → карточки (обрабатывает бот)
    match /syncReq/{uid} {
      allow create, update: if linked() && request.auth.uid == uid   // v258: будит бота только аккаунт с подтверждённым Discord
        && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
    }
    // фото для раздела «Руководство»: читают все, пишет только сам владелец профиля с ключом (или владелец сайта)
    match /ldrPhotos/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && (isOwner() || myTier() >= 1)
        && (request.method == 'delete' || (request.resource.data.keys().hasOnly(['d','n'])
            && request.resource.data.d is string && request.resource.data.d.size() <= 410000
            && (request.resource.data.d.matches('^data:image/(jpeg|gif);base64,.*') || request.resource.data.d.matches('^ph:[A-Za-z0-9]{20}$')) && reqStr(request.resource.data, 'n', 160)));
    }
    match /avatars/{uid} {
      allow read: if linked();   // v258: читают и пишут только аккаунты с подтверждённым Discord; удалить свою — как раньше
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if linked() && request.auth.uid == uid
        && (request.resource.data.keys().hasOnly(['d']) && request.resource.data.d is string
            && request.resource.data.d.size() <= 410000 && (request.resource.data.d.matches('^data:image/(jpeg|gif);base64,.*') || request.resource.data.d.matches('^ph:[A-Za-z0-9]{20}$')));
    }
    // mem/{uid}: отметка «член партии» (пишет только admin SDK)
    match /mem/{uid} { allow get: if signedIn() && request.auth.uid == uid; allow list, write: if false; }
    // v213/v216: вход и регистрация (kind 'reg') через Discord без пароля. Браузер (без входа) кладёт запрос со случайным id
    // (128 бит, 32 hex): Discord ID, status 'pending'. v223: бот шлёт 6-значный код в ЛС (хэш — в loginCodes/{id}, видит только бот),
    // человек вводит его на сайте (status 'check' + code), бот сверяет (5 попыток, 5 минут) и пишет custom token.
    // v229: по коду из ЛС входят все, включая владельца и ступень 5+ (правила ступень здесь не проверяют). Кнопок «Подтвердить вход» больше нет.
    // v223 фаза 3: старых запросов с 4-значным кодом (кнопка «Подтвердить вход») больше нет.
    // Читать — только зная id (get), перечислять нельзя; удалить — зная id.
    match /loginRequests/{id} {
      allow create: if id.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['did','code','status','t','kind'])
        && request.resource.data.keys().hasAll(['did','status','t'])
        && (!('kind' in request.resource.data) || request.resource.data.kind in ['login','reg'])
        && request.resource.data.did is string && request.resource.data.did.matches('^[0-9]{15,21}$')
        && !('code' in request.resource.data)
        && request.resource.data.status == 'pending' && request.resource.data.t == request.time;
      // ввод кода из ЛС: только status и code, после того как бот отправил код (sent) или отклонил прошлый ввод (bad)
      allow update: if id.matches('^[0-9a-f]{32}$')
        && resource.data.get('status', '') in ['sent','bad']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','code'])
        && request.resource.data.status == 'check'
        && request.resource.data.code is string && request.resource.data.code.matches('^[0-9]{6}$');
      allow get, delete: if id.matches('^[0-9a-f]{32}$');
      allow list: if false;
    }
    // v257: официальная кнопка Discord (OAuth2). Сайт кладёт одноразовый code из адреса возврата; обмен кода на Discord ID,
    // проверки и custom token — только бот (Client Secret у него). Без входа (вход и происходит), id — 128 бит, только по id.
    match /oauthRequests/{id} {
      allow create: if id.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['code','status','t','kind'])
        && request.resource.data.keys().hasAll(['code','status','t','kind'])
        && request.resource.data.kind in ['login','reg']
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-Za-z0-9_-]{8,128}$')
        && request.resource.data.status == 'pending' && request.resource.data.t == request.time;
      allow get, delete: if id.matches('^[0-9a-f]{32}$');
      allow update, list: if false;
    }
    // loginCodes/{id}: хэш кода входа — только бот
    match /loginCodes/{id} { allow read, write: if false; }
    // ---------- v222: привязка Discord ----------
    // dvf/{uid}: отметка «Discord ID аккаунта подтверждён» (бот: код из ЛС, вход/регистрация через Discord). Видит только сам.
    match /dvf/{uid} { allow get: if signedIn() && request.auth.uid == uid; allow list, write: if false; }
    // linkCodes/{uid}: хэш кода привязки — только бот
    match /linkCodes/{uid} { allow read, write: if false; }
    // linkReq/{uid}: сайт просит код (status 'pending') или отдаёт введённый код (status 'check'); итог пишет бот.
    // Discord ID — только логин этого аккаунта ({did}@vppka.local).
    match /linkReq/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      // v258: только у аккаунта с профилем (старые аккаунты без привязки). «Голый» email-аккаунт профиль создать не может → код в ЛС не попросит.
      allow create, update: if signedIn() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.auth.token.email is string && request.auth.token.email.matches('^[0-9]{15,21}@vppka[.]local$')
        && request.resource.data.keys().hasOnly(['did','status','t','code'])
        && request.resource.data.did == request.auth.token.email.split('@')[0]
        && request.resource.data.t == request.time
        && ((request.resource.data.status == 'pending' && !('code' in request.resource.data))
            || (request.resource.data.status == 'check' && resource != null && resource.data.get('status', '') in ['sent','bad']
                && request.resource.data.code is string && request.resource.data.code.matches('^[0-9]{6}$')));
      allow delete: if false;
    }
    // v224: публичный статик карточки members/{mid} — pubStatik/{mid} = {s: '000-000'}. Читают все (и гости).
    // v225: фото отдельно от карточек. В карточке — ссылка «ph:<id>»; полный размер photos/{id}.d, миниатюра photoThumbs/{id}.d.
    // Читают все (карточки видят гости). Создаёт любой вошедший с подтверждённым Discord (linked: и при регистрации, до профиля),
    // только от своего имени (by = uid), только новый документ; менять и удалять — владелец сайта (isSuper) и бот.
    function photoOk(d, max) {
      return d.keys().hasOnly(['d','by','at']) && d.by == request.auth.uid && d.at == request.time
        && d.d is string && d.d.size() <= max && d.d.matches('^data:image/(jpeg|png|webp|gif);base64,.*');
    }
    // v230: загрузивший может удалить своё фото (by == uid); владелец и бот — любое. Неиспользуемые фото старше часа удаляет бот.
    // Счётчик загрузок phq/{uid} = {at, n, last}: не больше 20 за 10 минут; сайт v230 пишет его тем же пакетом, что и фото.
    // v258: фото и миниатюра принимаются только вместе со счётчиком phq/{uid} в той же пачке (phq.last = id этого фото;
    // правила phq ниже: не больше 20 за 10 минут). Без счётчика сайт сохраняет картинку как раньше, в самом документе.
    function phqCounted(id) {
      let q = /databases/$(database)/documents/phq/$(request.auth.uid);
      return existsAfter(q) && getAfter(q).data.get('last', '') == id
        && (!exists(q) || get(q).data.get('last', '') != id);
    }
    match /photos/{id} {
      allow get: if true;
      allow create: if linked() && id.matches('^[A-Za-z0-9]{20}$') && photoOk(request.resource.data, 900000) && phqCounted(id);
      allow delete: if signedIn() && resource.data.get('by', '') == request.auth.uid;
    }
    match /photoThumbs/{id} {
      allow get: if true;
      allow create: if linked() && id.matches('^[A-Za-z0-9]{20}$') && photoOk(request.resource.data, 160000) && phqCounted(id);
      allow delete: if signedIn() && resource.data.get('by', '') == request.auth.uid;
    }
    function phqOk(d) {
      return d.keys().hasOnly(['at','n','last']) && d.n is int && d.last is string && d.last.matches('^[A-Za-z0-9]{20}$');
    }
    match /phq/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if linked() && request.auth.uid == uid && phqOk(request.resource.data)
        && request.resource.data.at == request.time && request.resource.data.n == 1;
      allow update: if linked() && request.auth.uid == uid && phqOk(request.resource.data)
        && ((resource.data.at < request.time - duration.value(10, 'm') && request.resource.data.at == request.time && request.resource.data.n == 1)
          || (request.resource.data.at == resource.data.at && request.resource.data.n == resource.data.n + 1 && request.resource.data.n <= 20));
    }
    // Пишут только бот (сервисный аккаунт, копия users/{uid}/priv/p.passport) и владелец (общее правило isSuper).
    // Сам priv/p (там же дата рождения) по-прежнему закрыт.
    match /pubStatik/{mid} {
      allow read: if true;
    }
    // Тексты страниц (вместо правки content.json с сайта). Нет документа — сайт берёт content.json.
    // ---------- v276: журнал изменений (auditLog) ----------
    // Запись — после успешной правки с сайта (audit.js): только от своего имени (by = uid, did = свой подтверждённый Discord ID),
    // время сервера, ограниченный набор полей и длин. Записи неизменяемы; удаляет только владелец.
    // Читают: владелец, «Администратор сайта» (m13) и зам. начальника техотдела (m12) — по документам мест, как в v275.
    match /auditLog/{id} {
      function auditViewer() {
        let vd = myVDid();
        return isOwner() || (vd != '' && (vd == seatDid('m13') || vd == seatDid('m12')));
      }
      allow get, list: if auditViewer();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['by','did','name','seat','sec','act','ref','sum','at'])
        && request.resource.data.keys().hasAll(['by','did','sec','act','ref','sum','at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.sec in ['news','events','votes','notifications','members','applications','users','accessKeys','content','config','discordOut','expulsions','banners']
        && request.resource.data.act in ['create','update','delete']
        && reqStr(request.resource.data, 'ref', 200) && reqStr(request.resource.data, 'sum', 300)
        && optStr(request.resource.data, 'name', 120) && optStr(request.resource.data, 'seat', 12)
        && request.resource.data.did is string && request.resource.data.did != ''
        && request.resource.data.did == myVDid();
      allow update: if false;
      allow delete: if isOwner();
    }

    match /content/{id} {
      allow read: if true;
      allow write: if isSuper();
    }
    // Суперпользователь (владелец / начальник техотдела) может читать и менять любой документ.
    // Остальным эта строка ничего не даёт: их по-прежнему пускают только правила выше.
    // v221: исключение — корзина мероприятий неизменяема и для владельца (удалить/«Восстановить» — правило выше).
    match /{document=**} {
      allow read: if isSuper();
      allow write: if isSuper() && document[0] != 'eventsArchive' && document[0] != 'auditLog'; // v276: журнал не правится и владельцем (удаление — правило выше)
    }
  }
}
