rules_version = '2';
// ВППКА — правила Firestore. Публикуются владельцем в консоли Firebase:
// Firestore Database → Rules → вставить весь этот текст → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- помощники ----------
    function signedIn() { return request.auth != null; }
    function docs() { return /databases/$(database)/documents; }
    function keyPath(h) { return /databases/$(database)/documents/accessKeys/$(h); }
    function isHash(h) { return h is string && h.matches('^[0-9a-f]{64}$'); }

    // Владелец: uid перечислен в config/owners.uids (документ создаётся только из консоли)
    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/owners)
        && request.auth.uid in get(/databases/$(database)/documents/config/owners).data.uids;
    }
    // Ранг по ключу: берётся из accessKeys/{keyHash} пользователя (ключ удалён → ранг 0)
    function keyRank() {
      let up = /databases/$(database)/documents/users/$(request.auth.uid);
      let h = exists(up) ? get(up).data.get('keyHash', '') : '';
      return isHash(h) && exists(keyPath(h))
          && get(keyPath(h)).data.get('revoked', false) == false
          && get(keyPath(h)).data.discordId == get(up).data.discordId
          && request.auth.token.email == get(up).data.discordId + '@vppka.local'
        ? get(keyPath(h)).data.rank : 0;
    }
    // Доп. право: ключ с canEditChairman==true может править запись председателя (ранг 100)
    function canChair() {
      let up = /databases/$(database)/documents/users/$(request.auth.uid);
      let h = exists(up) ? get(up).data.get('keyHash', '') : '';
      return signedIn() && keyRank() >= 1 && isHash(h)
          && get(keyPath(h)).data.get('canEditChairman', false) == true;
    }
    function myRank() { return !signedIn() ? 0 : (isOwner() ? 1000 : keyRank()); }

    // необязательное строковое поле не длиннее max
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function reqStr(d, k, max) { return (k in d) && d[k] is string && d[k].size() > 0 && d[k].size() <= max; }

    // ---------- пользователи ----------
    match /users/{uid} {
      // Ключ либо отсутствует целиком, либо существует и rank/roleName совпадают с ключом
      function validKey(d) {
        return (!('keyHash' in d) && !('rank' in d) && !('roleName' in d))
          || (isHash(d.get('keyHash', null)) && exists(keyPath(d.keyHash))
              && get(keyPath(d.keyHash)).data.get('revoked', false) == false
              && get(keyPath(d.keyHash)).data.discordId == d.discordId
              && d.get('rank', null) == get(keyPath(d.keyHash)).data.rank
              && d.get('roleName', null) == get(keyPath(d.keyHash)).data.roleName);
      }
      function validUser(d) {
        return d.keys().hasOnly(['discordLink','discordId','displayName','createdAt','keyHash','rank','roleName'])
          && reqStr(d, 'discordId', 64) && optStr(d, 'discordLink', 200) && optStr(d, 'displayName', 40)
          && request.auth.token.email == d.discordId + '@vppka.local';
      }
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if signedIn() && request.auth.uid == uid && validUser(request.resource.data) && validKey(request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','keyHash','rank','roleName'])
        && validUser(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['keyHash','rank','roleName'])
            || validKey(request.resource.data));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- ключи доступа: id = sha256(ключ) hex; ключ привязан к одному discordId ----------
    match /accessKeys/{h} {
      allow get: if signedIn();                 // нужно знать хэш, т.е. сам ключ
      allow list: if myRank() >= 100;           // перечислять может только управляющий ключами
      allow create, update: if myRank() >= 100 && isHash(h)
        && request.resource.data.keys().hasOnly(['rank','roleName','discordId','label','createdBy','createdAt','revoked','revokedAt','canEditChairman'])
        && (!('canEditChairman' in request.resource.data) || request.resource.data.canEditChairman is bool)
        && (!('revoked' in request.resource.data) || request.resource.data.revoked is bool)
        && reqStr(request.resource.data, 'discordId', 64)
        && request.resource.data.rank is int && request.resource.data.rank >= 1
        && request.resource.data.rank < myRank()
        && reqStr(request.resource.data, 'roleName', 60) && optStr(request.resource.data, 'label', 100)
        && (resource == null || resource.data.rank < myRank());
      allow delete: if myRank() >= 100 && resource.data.rank < myRank();
    }

    // ---------- служебное: только из консоли ----------
    match /config/{d} {
      allow get: if signedIn() && d == 'owners';
      allow list, write: if false;
    }

    // ---------- заявки в партию ----------
    match /applications/{id} {
      function validAnswers(a) {
        return a is map
          && a.keys().hasOnly(['fio','passport','discord','source','reason','bio'])
          && a.keys().hasAll(['fio','passport','discord','source','reason','bio'])
          && reqStr(a, 'fio', 2000) && reqStr(a, 'passport', 2000) && reqStr(a, 'discord', 2000)
          && reqStr(a, 'source', 2000) && reqStr(a, 'reason', 2000) && reqStr(a, 'bio', 2000);
      }
      allow create: if request.resource.data.keys().hasOnly(['answers','status','createdAt','uid','discordId'])
        && request.resource.data.keys().hasAll(['answers','status','createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && validAnswers(request.resource.data.answers)
        && (!('uid' in request.resource.data) || (signedIn() && request.resource.data.uid == request.auth.uid))
        && optStr(request.resource.data, 'discordId', 64);
      allow read: if myRank() >= 1;
      allow update: if myRank() >= 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt','reviewerRole'])
        && request.resource.data.status in ['new','accepted','rejected','member']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && optStr(request.resource.data, 'reviewerRole', 60);
      allow delete: if myRank() >= 100;
    }

    // ---------- новости ----------
    match /news/{id} {
      function validNews(d) {
        return d.keys().hasOnly(['title','text','image','date','author','createdAt','updatedAt'])
          && reqStr(d, 'title', 200) && reqStr(d, 'text', 20000)
          && d.get('date', '') is string && d.get('date', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && optStr(d, 'image', 900000)
          && (!('author' in d) || d.author == request.auth.uid || (resource != null && d.author == resource.data.get('author', null)));
      }
      allow read: if true;
      allow create, update: if myRank() >= 1 && validNews(request.resource.data);
      allow delete: if myRank() >= 1;
    }

    // ---------- состав / руководство ----------
    match /members/{id} {
      function validMember(d) {
        return d.keys().hasOnly(['name','role','group','photo','bio','quote','joined','birth','city','achievements',
                                 'discord','forum','contact','rank','order','updatedBy','updatedAt'])
          && reqStr(d, 'name', 100) && optStr(d, 'role', 120) && optStr(d, 'group', 80)
          && optStr(d, 'photo', 900000) && optStr(d, 'bio', 5000) && optStr(d, 'quote', 500)
          && optStr(d, 'joined', 60) && optStr(d, 'birth', 60) && optStr(d, 'city', 100)
          && optStr(d, 'achievements', 5000) && optStr(d, 'discord', 200) && optStr(d, 'forum', 300)
          && optStr(d, 'contact', 200)
          && d.get('rank', -1) is int && d.rank >= 0
          && (!('order' in d) || d.order is int)
          && (!('updatedBy' in d) || d.updatedBy == request.auth.uid);
      }
      allow read: if true;
      // нельзя назначить ранг >= своего и нельзя трогать равных/старших
      allow create: if validMember(request.resource.data) && request.resource.data.rank < myRank();
      allow update: if resource.data.rank < myRank()
        && validMember(request.resource.data) && request.resource.data.rank < myRank()
        // председатель: только правка полей, ранг менять нельзя, удалять нельзя
        || (resource.data.rank == 100 && canChair()
            && validMember(request.resource.data) && request.resource.data.rank == resource.data.rank);
      allow delete: if resource.data.rank < myRank();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
