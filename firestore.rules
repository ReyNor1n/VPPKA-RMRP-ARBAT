rules_version = '2';
// ВППКА — правила Firestore. Публикуются владельцем в консоли Firebase:
// Firestore Database → Rules → вставить весь этот текст → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- помощники ----------
    function signedIn() { return request.auth != null; }
    function docs() { return /databases/$(database)/documents; }
    function keyPath(h) { return /databases/$(database)/documents/accessKeys/$(h); }
    function isHash(h) { return h is string && h.matches('^[0-9a-f]{64}$'); }

    // Владелец: uid перечислен в config/owners.uids (документ создаётся только из консоли)
    function isOwner() {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/config/owners).data.uids;
    }
    // Суперпользователь (Начальник технического отдела) = владелец из config/owners.
    // Документ owners пишется только из консоли, поэтому право нельзя выдать себе с сайта.
    function isSuper() { return isOwner(); }
    // Действующий ключ пользователя (данные accessKeys/{keyHash}) или {} если ключа нет / аннулирован
    function myKey() {
      let up = /databases/$(database)/documents/users/$(request.auth.uid);
      let u = exists(up) ? get(up).data : {};
      let h = u.get('keyHash', '');
      let k = isHash(h) && exists(keyPath(h)) ? get(keyPath(h)).data : {};
      return k.get('revoked', false) == false && k.get('discordId', null) == u.get('discordId', '')
          && request.auth.token.email == u.get('discordId', '') + '@vppka.local'
        ? k : {};
    }
    function keyRank() { return myKey().get('rank', 0); }
    // Ступень (tier) = первая цифра ключа, хранится в accessKeys.tier (ключи хэшированы)
    function keyTier() { return myKey().get('tier', 0); }
    // Доп. право: ключ с canEditChairman==true может править запись председателя (ранг 100)
    function canChair() { return signedIn() && myKey().get('canEditChairman', false) == true; }
    // Доп. право: ключ с canViewMembers==true видит список участников партии (users)
    function canMembers() { return signedIn() && myKey().get('canViewMembers', false) == true; }
    // Ступень владельца = 9 (выше любого ключа)
    function myTier() { return !signedIn() ? 0 : (isOwner() ? 9 : keyTier()); }
    // Ступень другого пользователя по его ключу (нет ключа → 0)
    function userTier(uid) {
      let up = /databases/$(database)/documents/users/$(uid);
      let h = exists(up) ? get(up).data.get('keyHash', '') : '';
      return isHash(h) && exists(keyPath(h)) && get(keyPath(h)).data.get('revoked', false) == false
        ? get(keyPath(h)).data.get('tier', 0) : 0;
    }
    // член партии: действующий ключ, принятая заявка с id = uid, или отметка mem/{uid} (ставит бот/админ)
    function partyMember() {
      return signedIn() && (keyRank() >= 1
        || exists(/databases/$(database)/documents/mem/$(request.auth.uid))
        || (exists(/databases/$(database)/documents/applications/$(request.auth.uid))
            && get(/databases/$(database)/documents/applications/$(request.auth.uid)).data.status in ['accepted','member']));
    }
    function myRank() { return !signedIn() ? 0 : (isOwner() ? 1000 : keyRank()); }
    // аккаунт подтверждён: профиль users/{uid} существует (создать его можно только с кодом от бота в ЛС Discord)
    function verified() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    // ---------- звания членов партии: менять могут только Председатель ЦК (m1), его заместители (m4, m5) и владелец сайта ----------
    // кто есть кто — по документам мест руководства (members/m1, m4, m5), а не по данным клиента
    // Звания; applications.partyRank 1..5 = rkList()[partyRank - 1]. «Кандидат» упразднён 20.10.2026.
    function rkList() { return ['Член партии','Активист','Старший член партии','Ветеран партии','Почётный член партии']; }
    function seatDoc(s) { return /databases/$(database)/documents/members/$(s); }
    // Нет документа места — пустой Discord, а не ошибка всего правила.
    function seatDid(s) { return get(seatDoc(s)).data.get('discordId', ''); }
    // Распорядители: владелец, Председатель ЦК (m1), его заместители (m4, m5) и заместитель начальника техотдела (m12).
    function rkAdminDids() { return ['646280678736003073', seatDid('m1'), seatDid('m4'), seatDid('m5'), seatDid('m12')]; }
    // Председатель ЦК — тот, кто сейчас сидит на m1. Замы свои и чужие места m4/m5 не переназначают.
    function chairNow() { return isSuper() || (myVDid() != '' && myVDid() == seatDid('m1')); }
    function myVDid() {
      let up = /databases/$(database)/documents/users/$(request.auth.uid);
      let u = signedIn() && request.auth.token.email is string && exists(up) ? get(up).data : {};
      return u.get('discordId', '') != '' && request.auth.token.email == u.get('discordId', '') + '@vppka.local'
        ? u.discordId : '';
    }
    function rankAdmin() { return isOwner() || (myVDid() != '' && myVDid() in rkAdminDids()); }
    // Discord ID всех, кто сейчас занимает места руководства: config/ldrSeats.dids.
    // Список целиком переписывают те, кто назначает (rankAdmin), после назначения или снятия.
    function ldrSeatsPath() { return /databases/$(database)/documents/config/ldrSeats; }
    // цель — рядовой член партии: не распорядитель званий и не обладатель места руководства; нет списка мест → запрет
    function rkTargetOk(did) {
      return did == '' || (!(did in rkAdminDids()) && !(did in get(ldrSeatsPath()).data.get('dids', [])));
    }

    // необязательное строковое поле не длиннее max
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function reqStr(d, k, max) { return (k in d) && d[k] is string && d[k].size() > 0 && d[k].size() <= max; }

    // ---------- пользователи ----------
    match /users/{uid} {
      // Ключ либо отсутствует целиком, либо существует и rank/roleName совпадают с ключом
      function validKey(d) {
        return (!('keyHash' in d) && !('rank' in d) && !('roleName' in d))
          || (isHash(d.get('keyHash', null)) && exists(keyPath(d.keyHash))
              && get(keyPath(d.keyHash)).data.get('revoked', false) == false
              && get(keyPath(d.keyHash)).data.discordId == d.discordId
              && d.get('rank', null) == get(keyPath(d.keyHash)).data.rank
              && d.get('roleName', null) == get(keyPath(d.keyHash)).data.roleName);
      }
      function validUser(d) {
        return d.keys().hasOnly(['discordLink','discordId','displayName','createdAt','keyHash','rank','roleName','photo','avatar','fio','birth','passport','vcode'])
          && optStr(d, 'fio', 100) && (!('birth' in d) || (d.birth is string && d.birth.matches('^[0-9]{2}[.][0-9]{2}[.][0-9]{4}$')))
          && (!('passport' in d) || (d.passport is string && d.passport.matches('^[0-9]{3}-[0-9]{3}$')))
          && reqStr(d, 'discordId', 64) && optStr(d, 'discordLink', 200) && optStr(d, 'displayName', 40)
          && (!('photo' in d) || (d.photo is string && d.photo.size() <= 410000 && d.photo.matches('^data:image/(jpeg|gif);base64,.*')))
          && (!('avatar' in d) || (d.avatar is string && d.avatar.size() <= 410000 && d.avatar.matches('^data:image/(jpeg|gif);base64,.*')))
          && request.auth.token.email == d.discordId + '@vppka.local';
      }
      allow read: if signedIn() && (request.auth.uid == uid || isOwner() || canMembers() || myTier() >= 5);
      // новый аккаунт: обязателен код подтверждения Discord, выданный ботом в ЛС (verifyCodes/{discordId}_{code})
      allow create: if signedIn() && request.auth.uid == uid && validUser(request.resource.data) && validKey(request.resource.data)
        && request.resource.data.get('vcode', '') is string && request.resource.data.get('vcode', '').matches('^[A-Z0-9]{8}$')
        && exists(/databases/$(database)/documents/verifyCodes/$(request.resource.data.discordId + '_' + request.resource.data.vcode))
        && get(/databases/$(database)/documents/verifyCodes/$(request.resource.data.discordId + '_' + request.resource.data.vcode)).data.exp > request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','keyHash','rank','roleName','photo','avatar','fio','birth','passport'])
        && validUser(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['keyHash','rank','roleName'])
            || validKey(request.resource.data));
      allow delete: if signedIn() && request.auth.uid == uid;
      // РП-данные персонажа (дата рождения, паспорт-статик): видят члены партии (ключ, принятая заявка или отметка mem/{uid}); гости — нет
      match /priv/{d} {
        allow read: if signedIn() && (request.auth.uid == uid || isOwner() || partyMember());
        allow write: if signedIn() && request.auth.uid == uid && d == 'p'
          && request.resource.data.keys().hasOnly(['birth','passport'])
          && (!('birth' in request.resource.data) || (request.resource.data.birth is string && request.resource.data.birth.matches('^[0-9]{2}[.][0-9]{2}[.][0-9]{4}$')))
          && (!('passport' in request.resource.data) || (request.resource.data.passport is string && request.resource.data.passport.matches('^[0-9]{3}-[0-9]{3}$')));
      }
      // удаление гостя: владелец или ступень 4+; нельзя удалять держателей ключей, владельцев и служебный аккаунт
      allow delete: if signedIn() && (isOwner() || myTier() >= 4)
        && request.auth.uid != uid && uid != 'ZpVGAXbbg1a9I8kRsNEm0OU8QAt2'
        && resource.data.get('keyHash', '') == ''
        && !(uid in get(/databases/$(database)/documents/config/owners).data.uids);
    }

    // ---------- ключи доступа: id = sha256(ключ) hex; ключ привязан к одному discordId ----------
    match /accessKeys/{h} {
      allow get: if signedIn();                 // нужно знать хэш, т.е. сам ключ
      allow list: if myRank() >= 100;           // перечислять может только управляющий ключами
      allow create, update: if myRank() >= 100 && isHash(h)
        && request.resource.data.keys().hasOnly(['rank','roleName','discordId','label','createdBy','createdAt','revoked','revokedAt','canEditChairman','canViewMembers','tier'])
        && (!('tier' in request.resource.data) || (request.resource.data.tier is int && request.resource.data.tier >= 0 && request.resource.data.tier <= 9))
        && (!('canEditChairman' in request.resource.data) || request.resource.data.canEditChairman is bool)
        && (!('canViewMembers' in request.resource.data) || request.resource.data.canViewMembers is bool)
        && (!('revoked' in request.resource.data) || request.resource.data.revoked is bool)
        && reqStr(request.resource.data, 'discordId', 64)
        && request.resource.data.rank is int && request.resource.data.rank >= 1
        && request.resource.data.rank < myRank()
        && reqStr(request.resource.data, 'roleName', 60) && optStr(request.resource.data, 'label', 100)
        && (resource == null || resource.data.rank < myRank());
      allow delete: if myRank() >= 100 && resource.data.rank < myRank();
    }

    // ---------- служебное: owners и вебхуки только из консоли; список должностей пишут назначающие ----------
    match /config/{d} {
      allow get: if (signedIn() && d == 'owners') || (d == 'discord' && myTier() >= 4) || (d == 'ldrSeats' && rankAdmin());
      // Список Discord тех, кто занимает руководящие места. Пишут те же, кто назначает: целиком поле dids.
      function didsOk() {
        return request.resource.data.dids is list && request.resource.data.dids.size() <= 80
          && (request.resource.data.dids.size() == 0 || (request.resource.data.dids[0] is string && request.resource.data.dids[0].size() <= 32));
      }
      allow create: if d == 'ldrSeats' && rankAdmin()
        && request.resource.data.keys().hasOnly(['dids']) && didsOk();
      allow update: if d == 'ldrSeats' && rankAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dids']) && didsOk();
      allow write: if d == 'discord' && isOwner()
        && request.resource.data.keys().hasOnly(['webhook','appsWebhook','roleIds'])
        && (!('webhook' in request.resource.data) || request.resource.data.webhook.matches('^https://(discord|discordapp)[.]com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+$'))
        && (!('appsWebhook' in request.resource.data) || request.resource.data.appsWebhook.matches('^https://(discord|discordapp)[.]com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+$'))
        && (!('roleIds' in request.resource.data) || (request.resource.data.roleIds is list && request.resource.data.roleIds.size() <= 10));
      allow list: if false;
    }

    // ---------- уведомления (созывы, объявления) ----------
    match /notifications/{id} {
      // созывы и объявления видны всем (баннер на главной), прочее — вошедшим
      allow read: if signedIn() || resource.data.type in ['convocation','other'];
      // тип проверяется первым: для личных уведомлений (appoint/recall) ключ не читается — экономит лимит обращений
      allow create: if request.resource.data.type in ['news','convocation','other']
        && request.resource.data.keys().hasOnly(['type','title','text','when','author','authorName','createdAt'])
        && optStr(request.resource.data, 'authorName', 120)
        && myTier() >= 4
        && reqStr(request.resource.data, 'title', 200)
        && optStr(request.resource.data, 'text', 2000) && optStr(request.resource.data, 'when', 100)
        && request.resource.data.author == request.auth.uid
        && request.resource.data.createdAt == request.time;
      // Личное уведомление о назначении или снятии с руководящей должности.
      // Пишет только тот, кто вправе назначать; адресат — текущий держатель этой должности, не произвольный пользователь.
      function seatNoteOk() {
        let seat = /databases/$(database)/documents/members/$(request.resource.data.seat);
        let held = get(seat).data;
        return rankAdmin()
          && request.resource.data.keys().hasOnly(['type','title','text','author','authorName','createdAt','to','seat'])
          && request.resource.data.type in ['appoint','recall']
          && request.resource.data.author == request.auth.uid
          && request.resource.data.createdAt == request.time
          && reqStr(request.resource.data, 'title', 120)
          && reqStr(request.resource.data, 'text', 300)
          && optStr(request.resource.data, 'authorName', 160)
          && request.resource.data.to is string
          && request.resource.data.to.matches('^[0-9]{15,21}$')
          && request.resource.data.seat is string
          && request.resource.data.seat.matches('^[A-Za-z0-9_-]{1,40}$')
          && !request.resource.data.seat.matches('^p_.*')
          && request.resource.data.seat != 'm11'
          && held.get('discordId','') == request.resource.data.to
          && held.get('group','') != 'Члены партии'
          && held.get('role','') != 'Начальник технического отдела'
          && (held.get('rank',0) < 100 || isSuper())
          && (request.resource.data.type == 'recall' || held.get('updatedBy','') == request.auth.uid);
      }
      allow create: if seatNoteOk();
      allow update: if myTier() >= 4 && resource.data.type == 'convocation'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelled','cancelledAt','reason'])
        && request.resource.data.cancelled == true
        && request.resource.data.cancelledAt == request.time
        && optStr(request.resource.data, 'reason', 500);
      allow delete: if myTier() >= 4;
    }

    // ---------- заявки в партию ----------
    match /applications/{id} {
      function validAnswers(a) {
        return a is map
          && a.keys().hasOnly(['fio','passport','discord','source','reason','bio'])
          && a.keys().hasAll(['fio','passport','discord','source','reason','bio'])
          && reqStr(a, 'fio', 2000) && reqStr(a, 'passport', 2000) && reqStr(a, 'discord', 2000)
          && reqStr(a, 'source', 2000) && reqStr(a, 'reason', 2000) && optStr(a, 'bio', 4000);
      }
      // заявка с сайта: только вошедший, одна заявка на аккаунт (id документа = uid)
      allow create: if signedIn() && id == request.auth.uid
        && request.resource.data.keys().hasOnly(['answers','status','createdAt','uid','discordId'])
        && request.resource.data.keys().hasAll(['answers','status','createdAt','uid'])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && validAnswers(request.resource.data.answers)
        && request.resource.data.uid == request.auth.uid
        && optStr(request.resource.data, 'discordId', 64);
      // заявка из Discord (создаёт бот через служебный аккаунт владельца)
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['answers','status','createdAt','discordId','source','discordSourceId'])
        && request.resource.data.status == 'new' && request.resource.data.source == 'discord'
        && request.resource.data.createdAt == request.time
        && request.resource.data.answers is map
        && request.resource.data.answers.keys().hasOnly(['fio','passport','discord','source','reason','bio'])
        && reqStr(request.resource.data.answers, 'fio', 2000)
        && reqStr(request.resource.data, 'discordSourceId', 32)
        && optStr(request.resource.data, 'discordId', 64);
      allow read: if myTier() >= 3 || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
      // заявитель может удалить свою отклонённую или архивную (карточку удалили / уволен) заявку, чтобы подать новую
      allow delete: if signedIn() && id == request.auth.uid && resource.data.status in ['rejected','expelled'];
      function aChanged() { return request.resource.data.diff(resource.data).affectedKeys(); }
      // ступень заявителя: по ключу его аккаунта (нет аккаунта/ключа → 0)
      function targetTier() { return resource.data.get('uid', '') == '' ? 0 : userTier(resource.data.uid); }
      // рассмотреть заявку (принять/отклонить): ступень 3+
      function reviewOk() {
        return aChanged().hasOnly(['status','reviewedBy','reviewedAt','reviewerRole','rejectReason'])
          && myTier() >= 3
          && request.resource.data.status in ['new','accepted','rejected','member']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && optStr(request.resource.data, 'reviewerRole', 60)
          && optStr(request.resource.data, 'rejectReason', 500);
      }
      // повысить/понизить принятого члена партии: только Председатель ЦК, его заместители и владелец сайта
      function rankOk() {
        return aChanged().hasOnly(['partyRank','partyRole','rankedBy','rankedAt'])
          && rankAdmin() && rkTargetOk(resource.data.get('discordId', ''))
          && resource.data.status in ['accepted','member']
          && request.resource.data.get('partyRank', 0) is int
          && request.resource.data.get('partyRank', 0) >= 1 && request.resource.data.get('partyRank', 0) <= 5
          && request.resource.data.get('partyRole', '') == rkList()[request.resource.data.get('partyRank', 0) - 1]
          && request.resource.data.rankedBy == request.auth.uid
          && request.resource.data.rankedAt == request.time;
      }
      // увольнение из партии: ступень 5+, ступень цели ниже своей
      function expelOk() {
        return aChanged().hasOnly(['status','expelledBy','expelledAt'])
          && myTier() >= 5 && targetTier() < myTier()
          && resource.data.status in ['accepted','member'] && request.resource.data.status == 'expelled'
          && request.resource.data.expelledBy == request.auth.uid && request.resource.data.expelledAt == request.time;
      }
      // отметка о публикации заявки в Discord (ретранслятор владельца)
      function relayOk() { return isOwner() && aChanged().hasOnly(['discordPostedAt','discordMessageId','discordDecision']) && optStr(request.resource.data, 'discordMessageId', 32) && optStr(request.resource.data, 'discordDecision', 40); }
      allow update: if reviewOk() || rankOk() || relayOk() || expelOk();
      allow delete: if myRank() >= 100;
      // заявки удаляемого гостя: только новые/отклонённые, у заявителя нет ключа
      allow delete: if signedIn() && (isOwner() || myTier() >= 4)
        && resource.data.status in ['new','rejected','expelled'] && targetTier() == 0;
    }

    // ---------- история званий: видят члены партии, пишет ступень 4+ ----------
    match /rankHist/{id} {
      allow read: if isOwner() || partyMember() || myTier() >= 1;
      allow create: if (myTier() >= 4 || rankAdmin())
        && request.resource.data.keys().hasOnly(['did','kind','from','to','name','reason','by','byName','at'])
        && reqStr(request.resource.data, 'did', 64) && request.resource.data.kind in ['up','down','assign']
        && optStr(request.resource.data, 'from', 80) && optStr(request.resource.data, 'to', 80)
        && optStr(request.resource.data, 'name', 160) && optStr(request.resource.data, 'reason', 300)
        && optStr(request.resource.data, 'byName', 160)
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow delete: if isOwner();
    }

    // ---------- внутрипартийные голосования ----------
    match /votes/{id} {
      function vPath() { return /databases/$(database)/documents/votes/$(id); }
      function validVote(d) {
        return d.keys().hasOnly(['title','type','desc','options','deadline','closed','createdBy','createdAt','counts','total','discordMessageId','discordChannelId'])
          && reqStr(d, 'title', 200) && d.type in ['decision','candidates','amendment']
          && optStr(d, 'desc', 4000) && d.options is list && d.options.size() >= 2 && d.options.size() <= 10
          && d.deadline is int && d.closed is bool && d.counts is map && d.total is int;
      }
      allow read: if isOwner() || partyMember() || myTier() >= 1;
      allow create: if myTier() >= 5 && validVote(request.resource.data)
        && request.resource.data.total == 0 && request.resource.data.closed == false
        && request.resource.data.counts.size() == request.resource.data.options.size();
      // правка/закрытие: ступень 5+, счётчики не трогает
      allow update: if myTier() >= 5 && validVote(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','desc','deadline','closed']);
      allow delete: if myTier() >= 5;
      // голос: член партии, один раз, +1 к одному варианту вместе с бюллетенем ballots/{uid}
      function bPath() { return /databases/$(database)/documents/votes/$(id)/ballots/$(request.auth.uid); }
      allow update: if (partyMember() || myTier() >= 1) && resource.data.closed == false && request.time.toMillis() < resource.data.deadline
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts','total'])
        && !exists(bPath()) && existsAfter(bPath())
        && request.resource.data.total == resource.data.total + 1
        && request.resource.data.counts.diff(resource.data.counts).affectedKeys() == [string(getAfter(bPath()).data.opt)].toSet()
        && request.resource.data.counts[string(getAfter(bPath()).data.opt)] == resource.data.counts[string(getAfter(bPath()).data.opt)] + 1;
      match /ballots/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || myTier() >= 4);
        allow list: if myTier() >= 4;
        allow create: if signedIn() && request.auth.uid == uid && (partyMember() || myTier() >= 1)
          && request.resource.data.keys().hasOnly(['opt','at','n'])
          && request.resource.data.opt is int && request.resource.data.opt >= 0
          && request.resource.data.opt < get(vPath()).data.options.size()
          && request.resource.data.at == request.time && optStr(request.resource.data, 'n', 120)
          && getAfter(vPath()).data.total == get(vPath()).data.total + 1;
        allow delete: if myTier() >= 5;
      }
    }

    // ---------- мероприятия: читают все, правит ступень 4+ ----------
    match /events/{id} {
      function validEv(d) {
        return d.keys().hasOnly(['title','at','place','desc','image','createdBy','updatedAt','discordMessageId','att','status','endedAt','endedBy'])
          && (!('att' in d) || (d.att is list && d.att.size() <= 150))
          && (!('status' in d) || d.status == 'ended')
          && (!('endedBy' in d) || (d.endedBy is string && d.endedBy.size() > 0 && d.endedBy.size() <= 128))
          && (!('endedAt' in d) || d.endedAt is timestamp)
          && reqStr(d, 'title', 200) && d.at is int
          && optStr(d, 'place', 200) && optStr(d, 'desc', 4000) && optStr(d, 'image', 2000)
          && optStr(d, 'createdBy', 128) && optStr(d, 'discordMessageId', 32)
          && (!('updatedAt' in d) || d.updatedAt is int);
      }
      function evActor() {
        return isOwner() || myTier() >= 4
          || (signedIn() && resource.data.get('createdBy', '') == request.auth.uid);
      }
      function endOk() {
        return evActor()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endedAt','endedBy'])
          && request.resource.data.status == 'ended'
          && request.resource.data.endedBy == request.auth.uid
          && request.resource.data.endedAt == request.time;
      }
      function resumeOk() {
        return evActor()
          && resource.data.get('status', '') == 'ended'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endedAt','endedBy'])
          && !('status' in request.resource.data)
          && !('endedAt' in request.resource.data)
          && !('endedBy' in request.resource.data);
      }
      allow read: if true;
      allow create: if myTier() >= 4 && validEv(request.resource.data);
      allow update: if (myTier() >= 4 && validEv(request.resource.data)
          && !(resource.data.get('status', '') == 'ended'
               && request.resource.data.diff(resource.data).affectedKeys().hasAny(['att'])))
        || endOk() || resumeOk();
      allow delete: if myTier() >= 4;
    }

    // ---------- новости ----------
    match /news/{id} {
      function validNews(d) {
        return d.keys().hasOnly(['title','text','image','photos','videos','date','author','createdAt','updatedAt','pinned','likeCount','align'])
          && (!('align' in d) || d.align in ['center'])
          && (!('likeCount' in d) || d.likeCount is int)
          && (!('pinned' in d) || d.pinned is bool)
          && (!('photos' in d) || (d.photos is list && d.photos.size() <= 4))
          && (!('videos' in d) || (d.videos is list && d.videos.size() <= 5))
          && reqStr(d, 'title', 200) && reqStr(d, 'text', 20000)
          && d.get('date', '') is string && d.get('date', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && optStr(d, 'image', 900000)
          && (!('author' in d) || d.author == request.auth.uid || (resource != null && d.author == resource.data.get('author', null)));
      }
      allow read: if true;
      // новости (с фото и видео): ступень 4+
      allow create, update: if myTier() >= 4 && validNews(request.resource.data);
      allow delete: if myTier() >= 4;
      // лайк: вошедший меняет только likeCount на ±1 вместе со своим документом likes/{uid}
      function likePath() { return /databases/$(database)/documents/news/$(id)/likes/$(request.auth.uid); }
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount is int
        && ((!exists(likePath()) && existsAfter(likePath()) && request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1)
            || (exists(likePath()) && !existsAfter(likePath()) && request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1));
      match /likes/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid','t']) && request.resource.data.uid == uid && request.resource.data.t == request.time
          && getAfter(/databases/$(database)/documents/news/$(id)).data.get('likeCount', 0) == get(/databases/$(database)/documents/news/$(id)).data.get('likeCount', 0) + 1;
        allow delete: if signedIn() && request.auth.uid == uid
          && getAfter(/databases/$(database)/documents/news/$(id)).data.get('likeCount', 0) == get(/databases/$(database)/documents/news/$(id)).data.get('likeCount', 0) - 1;
      }
    }

    // ---------- состав / руководство ----------
    match /members/{id} {
      function validMember(d) {
        return d.keys().hasOnly(['name','role','group','photo','bio','quote','joined','birth','city','achievements',
                                 'discord','forum','contact','rank','order','updatedBy','updatedAt','discordId','tier','reportsTo','duties'])
          && optStr(d, 'reportsTo', 120)
          && (!('duties' in d) || (d.duties is list && d.duties.size() <= 12))
          && d.get('tier', 0) is int && d.get('tier', 0) >= 0 && d.get('tier', 0) <= 9
          && reqStr(d, 'name', 100) && optStr(d, 'role', 120) && optStr(d, 'group', 80)
          && optStr(d, 'photo', 900000) && optStr(d, 'bio', 5000) && optStr(d, 'quote', 500)
          && optStr(d, 'joined', 60) && optStr(d, 'birth', 60) && optStr(d, 'city', 100)
          && optStr(d, 'achievements', 5000) && optStr(d, 'discord', 200) && optStr(d, 'forum', 300)
          && optStr(d, 'contact', 200) && optStr(d, 'discordId', 64)
          && d.get('rank', -1) is int && d.rank >= 0
          && (!('order' in d) || d.order is number)
          && (!('updatedBy' in d) || d.updatedBy == request.auth.uid);
      }
      allow read: if true;
      // ступень 4+: добавлять/повышать/понижать записи со ступенью ниже своей (tier записи = ступень ключа человека, нет → 0);
      // ранг 100 (председатель) назначает только владелец
      function tierEdit(d) {
        return myTier() >= 4 && validMember(d) && d.get('tier', 0) < myTier()
          && d.rank < (isOwner() ? 1000 : 100);
      }
      // Место начальника техотдела и пост председателя (ранг 100) не переназначают замы и председатель.
      function techSeat() {
        return id == 'm11' || resource.data.get('role', '') == 'Начальник технического отдела';
      }
      function techRoleNew() {
        return request.resource.data.get('role', '') == 'Начальник технического отдела' || id == 'm11';
      }
      // Карточка «Члены партии» только с id p_<...>. Вторая карточка на то же ФИО блокируется memClaim/{имя}.
      function partyIdOk() {
        return !(request.resource.data.get('group', '') == 'Члены партии' || id.matches('^p_.*'))
          || (id.matches('^p_[A-Za-z0-9_-]{8,128}$') && request.resource.data.group == 'Члены партии');
      }
      function claimPath() {
        return /databases/$(database)/documents/memClaim/$(request.resource.data.name);
      }
      function partyClaimOk() {
        return request.resource.data.get('group', '') != 'Члены партии'
          || (existsAfter(claimPath())
              && getAfter(claimPath()).data.memberId == id
              && getAfter(claimPath()).data.name == request.resource.data.name);
      }
      // Новая вакансия руководства: председатель, замы, начальник техотдела (и владелец). Не членская карточка и не пост m11.
      function vacCreateOk() {
        return rankAdmin() && validMember(request.resource.data) && !techRoleNew()
          && request.resource.data.name == 'Вакансия'
          && request.resource.data.get('group', '') != ''
          && request.resource.data.get('group', '') != 'Члены партии'
          && request.resource.data.rank is int && request.resource.data.rank >= 0 && request.resource.data.rank < 100
          && request.resource.data.get('tier', 0) is int && request.resource.data.get('tier', 0) >= 0 && request.resource.data.get('tier', 0) <= 5
          && request.resource.data.get('discordId', '') == ''
          && request.resource.data.get('updatedBy', '') == request.auth.uid
          && !id.matches('^p_.*');
      }
      allow create: if partyIdOk() && partyClaimOk() && !techRoleNew() && (tierEdit(request.resource.data) || vacCreateOk());
      // назначение человека на должность (смена discordId): владелец и ступень 5, как раньше
      function assignOk() { return request.resource.data.get('discordId', '') == resource.data.get('discordId', '') || myTier() >= 5; }
      // звание (role) записи «Члены партии» (p_*) — только распорядители званий
      function rkKeep() { return !id.matches('^p_.*') || request.resource.data.get('role', '') == resource.data.get('role', '') || rankAdmin(); }
      function sameSeat(k) { return request.resource.data.get(k, null) == resource.data.get(k, null); }
      // Назначение на уже существующую руководящую должность без смены роли, ранга и ступени.
      // Могут: председатель ЦК (m1), его заместители (m4, m5), начальник техотдела и владелец (rankAdmin).
      function deputySeat() { return id == 'm4' || id == 'm5'; }
      // Смена человека на месте зама — только председатель (m1) или владелец.
      function deputyReassign() {
        return deputySeat() && !chairNow()
          && (request.resource.data.get('discordId', '') != resource.data.get('discordId', '')
              || request.resource.data.get('name', '') != resource.data.get('name', ''));
      }
      // ВАЖНО: у правил Firestore лимит 1000 вычисленных выражений и 10 обращений к документам на запрос.
      // Права (владелец, распорядитель, председатель) считаются один раз и передаются аргументами,
      // а тяжёлая validMember() вызывается только в ветке, где без неё нельзя. Иначе у не-владельца
      // (председатель, замы) любое назначение/снятие/смена звания отклонялись по лимиту.
      // Назначение/снятие на существующей руководящей должности без смены роли, ранга, ступени и порядка.
      // Меняются только человек (name, discordId, discord, joined, bio, photo); остальное — как в документе.
      // td — заместитель начальника техотдела (m12), если он не занимает m1/m4/m5: своё место m12
      // и места, которые занимает владелец (m11, m17), он не меняет.
      function seatAssignOk(ra, chair, td) {
        let d = request.resource.data;
        return ra
          && !(td && (id == 'm12' || resource.data.get('discordId', '') == '646280678736003073'))
          && !id.matches('^p_.*')
          && resource.data.get('group', '') != 'Члены партии'
          && resource.data.get('rank', 0) < 100
          && (!deputySeat() || chair)
          && d.keys().hasOnly(['name','bio','discord','discordId','joined','photo','updatedBy','updatedAt',
                               'role','group','rank','tier','order','reportsTo','duties'])
          && d.get('updatedBy', '') == request.auth.uid
          && sameSeat('role') && sameSeat('group') && sameSeat('rank') && sameSeat('tier')
          && sameSeat('order') && sameSeat('reportsTo') && sameSeat('duties')
          && reqStr(d, 'name', 100) && optStr(d, 'discordId', 64) && optStr(d, 'discord', 200)
          && optStr(d, 'joined', 60) && optStr(d, 'bio', 5000) && optStr(d, 'photo', 900000);
      }
      // смена звания карточки p_*: только поле role (+ updatedBy/updatedAt), значение из списка званий, не у распорядителей
      function rankChangeOk(ra) {
        return ra && id.matches('^p_.*')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','updatedBy','updatedAt'])
          && resource.data.get('role', '') in rkList() && request.resource.data.get('role', '') in rkList()
          && request.resource.data.get('updatedBy', '') == request.auth.uid
          && rkTargetOk(resource.data.get('discordId', ''));
      }
      // автофото: владелец привязанной записи (discordId совпадает, ключ действителен) меняет только своё фото
      function selfPhotoOk() {
        return resource.data.get('discordId', '') != ''
          && request.auth.token.email == resource.data.discordId + '@vppka.local'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo','updatedBy','updatedAt'])
          && optStr(request.resource.data, 'photo', 900000)
          && (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == request.auth.uid)
          && keyRank() >= 1;
      }
      // ступень 4+: запись со ступенью ниже своей; смена человека (discordId) — ступень 5+; звание p_* — распорядители и только из rkList()
      function tierUpdOk(t, own, ra) {
        let lim = own ? 1000 : 100;
        return t >= 4
          && resource.data.get('tier', 0) < t && resource.data.rank < lim
          && (request.resource.data.get('discordId', '') == resource.data.get('discordId', '') || t >= 5)
          && request.resource.data.get('tier', 0) is int && request.resource.data.get('tier', 0) < t
          && request.resource.data.get('rank', -1) is int && request.resource.data.rank < lim
          && (!id.matches('^p_.*') || request.resource.data.get('role', '') == resource.data.get('role', '')
              || (ra && request.resource.data.get('role', '') in rkList()))
          && validMember(request.resource.data);
      }
      // председатель: только правка полей, ранг и ступень менять нельзя, удалять нельзя
      function chairEditOk() {
        return resource.data.rank == 100 && request.resource.data.get('rank', -1) == resource.data.rank
          && request.resource.data.get('tier', 0) == resource.data.get('tier', 0)
          && canChair() && validMember(request.resource.data);
      }
      // смена человека на месте зама (m4/m5) — только председатель (m1) или владелец
      function deputyReassignP(chair) {
        return deputySeat() && !chair
          && (request.resource.data.get('discordId', '') != resource.data.get('discordId', '')
              || request.resource.data.get('name', '') != resource.data.get('name', ''));
      }
      function updEntry(own, vd) {
        let ra = own || (vd != '' && vd in rkAdminDids());
        let chair = own || (deputySeat() && vd != '' && vd == seatDid('m1'));
        let td = !own && vd != '' && vd == seatDid('m12') && !(vd in [seatDid('m1'), seatDid('m4'), seatDid('m5')]);
        return !deputyReassignP(chair)
          && (seatAssignOk(ra, chair, td) || rankChangeOk(ra) || selfPhotoOk()
              || tierUpdOk(own ? 9 : keyTier(), own, ra) || chairEditOk());
      }
      allow update: if !techSeat() && !techRoleNew() && updEntry(isOwner(), myVDid());
      // m1, m4 и m5 не удаляет никто, кроме владельца (ему это даёт общее правило isSuper).
      // Занятое руководящее место не удаляется: его освобождают, имя становится «Вакансия». Карточки «Члены партии» удаляются как раньше.
      allow delete: if !techSeat() && !(id in ['m1', 'm4', 'm5', 'm12']) && resource.data.get('rank', 0) < 100
        && (id.matches('^p_.*') || resource.data.get('group', '') == 'Члены партии'
            || (resource.data.get('name', '') is string && (resource.data.get('name', '') == 'Вакансия' || resource.data.get('name', '').lower() == 'вакансия')))
        && ((myTier() >= 4 && resource.data.get('tier', 0) < myTier() && resource.data.rank < (isOwner() ? 1000 : 100))
            || (rankAdmin() && !id.matches('^p_.*') && resource.data.get('group', '') != 'Члены партии'));
    }
    // Замок от второй карточки члена партии с тем же ФИО. Создаётся вместе с members/p_* одной пачкой.
    // Правка и удаление уже существующей карточки замок не требуют: старые карточки его не имеют.
    match /memClaim/{key} {
      function claimCard(mid) { return /databases/$(database)/documents/members/$(mid); }
      function claimShape() {
        return (myTier() >= 4 || rankAdmin())
          && key == request.resource.data.name
          && request.resource.data.keys().hasOnly(['name','memberId','by'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
          && request.resource.data.memberId is string && request.resource.data.memberId.matches('^p_[A-Za-z0-9_-]{8,128}$')
          && request.resource.data.by == request.auth.uid
          && existsAfter(claimCard(request.resource.data.memberId))
          && getAfter(claimCard(request.resource.data.memberId)).data.name == request.resource.data.name
          && getAfter(claimCard(request.resource.data.memberId)).data.group == 'Члены партии';
      }
      // Чужой живой замок не переписываем. Можно обновить свой или занять ФИО, если прежняя карточка уже удалена.
      function claimFree() {
        return resource.data.memberId == request.resource.data.memberId
          || !exists(claimCard(resource.data.memberId))
          || get(claimCard(resource.data.memberId)).data.get('group', '') != 'Члены партии'
          || get(claimCard(resource.data.memberId)).data.get('name', '') != resource.data.get('name', '');
      }
      allow get: if signedIn();
      allow list: if isSuper() || myTier() >= 4 || rankAdmin();
      allow create: if claimShape();
      allow update: if claimShape() && claimFree();
      allow delete: if isSuper() || myTier() >= 4 || rankAdmin();
    }

    // ---------- увольнения: id = discordId; отметку и причину видят только ступень 4+ и владелец ----------
    match /expulsions/{did} {
      allow read: if myTier() >= 4;
      allow create, update: if myTier() >= 5
        && request.resource.data.keys().hasOnly(['name','reason','by','at'])
        && reqStr(request.resource.data, 'name', 100) && optStr(request.resource.data, 'reason', 500)
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow delete: if myTier() >= 5;
    }

    // ---------- личные сообщения ----------
    // Публичный справочник для поиска собеседников: имя, миниатюра, Discord. Владелец и служебный аккаунт сюда не пишутся.
    match /pub/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == uid || isOwner() || myTier() >= 5)
        && uid != 'ZpVGAXbbg1a9I8kRsNEm0OU8QAt2'
        && !(uid in get(/databases/$(database)/documents/config/owners).data.uids)
        && request.resource.data.keys().hasOnly(['n','ph','did','t'])
        && reqStr(request.resource.data, 'n', 40) && optStr(request.resource.data, 'did', 64)
        // did своего справочника = Discord ID из логина (нельзя выдать себя за другого)
        && (request.auth.uid != uid || (request.resource.data.get('did', '') == request.auth.token.email.split('@')[0] && verified()))
        && (!('ph' in request.resource.data) || (request.resource.data.ph is string && (request.resource.data.ph.size() <= 30000 && request.resource.data.ph.matches('^data:image/jpeg;base64,.*') || request.resource.data.ph.size() <= 100000 && request.resource.data.ph.matches('^data:image/gif;base64,.*'))));
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner() || myTier() >= 5);
    }
    // rankNotes: системный раздел чата «Повышения и понижения». Цель — по Discord ID (did).
    match /rankNotes/{id} {
      function myDid() { return request.auth.token.email.split('@')[0]; }
      allow read: if verified() && request.auth.token.email is string && resource.data.did == myDid();
      allow update: if verified() && request.auth.token.email is string && resource.data.did == myDid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read == true;
      allow create: if signedIn() && (myTier() >= 4 || rankAdmin())
        && request.resource.data.keys().hasOnly(['did','kind','text','by','byName','at','read'])
        && request.resource.data.did is string && request.resource.data.did.size() > 0 && request.resource.data.did.size() <= 64
        && request.resource.data.did != myDid()
        && request.resource.data.kind in ['up','down','assign']
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 160
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
        && request.resource.data.read == false;
      allow delete: if isOwner();
    }
    // chats/{a_b}: participants = [a,b] (по возрастанию), id = a_b
    match /chats/{chatId} {
      function owners() { return get(/databases/$(database)/documents/config/owners).data.uids; }
      function isPart() { return signedIn() && request.auth.uid in resource.data.participants; }
      function okUnread(d) { return d.unread is map && d.unread.keys().hasOnly(d.participants)
        && d.unread[d.participants[0]] is int && d.unread[d.participants[1]] is int; }
      function okLast(d) { return d.lastMessage is map && d.lastMessage.keys().hasOnly(['text','from','at'])
        && d.lastMessage.text is string && d.lastMessage.text.size() <= 2000
        && d.lastMessage.from == request.auth.uid && d.lastMessage.at == request.time; }
      allow read: if isPart() || (signedIn() && request.auth.uid == 'ZpVGAXbbg1a9I8kRsNEm0OU8QAt2');
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['participants','createdBy','updatedAt','lastMessage','unread','names'])
        && request.resource.data.participants is list && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && !('ZpVGAXbbg1a9I8kRsNEm0OU8QAt2' in request.resource.data.participants)
        // со скрытым владельцем может начать переписку только он сам
        && (isOwner() || !(request.resource.data.participants[0] in owners() || request.resource.data.participants[1] in owners()))
        && okUnread(request.resource.data) && okLast(request.resource.data)
        && (!('names' in request.resource.data) || (isOwner() && request.resource.data.names is map
            && request.resource.data.names.keys().hasOnly([request.auth.uid]) && request.resource.data.names[request.auth.uid] is string
            && request.resource.data.names[request.auth.uid].size() <= 40));
      allow update: if isPart()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastMessage','unread'])
        && okUnread(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage','updatedAt'])
            || (okLast(request.resource.data) && request.resource.data.updatedAt == request.time));
      allow delete: if false;
      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn() && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.keys().hasOnly(['from','text','at'])
          && request.resource.data.from == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // pushSubs/{uid}: подписки на push-уведомления; пишет только владелец, читает только служебный аккаунт
    match /pushSubs/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == 'ZpVGAXbbg1a9I8kRsNEm0OU8QAt2');
      allow create, update: if signedIn() && (request.auth.uid == uid || (request.method == 'update' && request.auth.uid == 'ZpVGAXbbg1a9I8kRsNEm0OU8QAt2')) && request.resource.data.keys().hasOnly(['subs','t'])
        && request.resource.data.subs is map && request.resource.data.subs.size() <= 10;
      allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == 'ZpVGAXbbg1a9I8kRsNEm0OU8QAt2');
    }

    // meta/site {version}: версия сайта для мгновенного автообновления; читают все, пишет только admin SDK
    match /meta/{d} {
      allow get: if d == 'site';
      allow list, write: if false;
    }
    // banners/{uid}: баннер профиля. Либо url (https .mp4/.webm), либо файл частями в chunks/{ver_i}. Видят все, меняет только владелец.
    // музыка профиля руководства: читают все, пишет сам руководитель (ключ доступа) или владелец
    match /ldrMusic/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && ((request.auth.uid == uid && myTier() >= 1) || isOwner())
        && request.resource.data.keys().hasOnly(['name','title','t','url','ver','n','mime','size'])
        && reqStr(request.resource.data, 'name', 160) && optStr(request.resource.data, 'title', 100)
        && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 600 && request.resource.data.url.matches('^https://[^ ]+$')))
        && (!('n' in request.resource.data) || (request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 12))
        && (!('mime' in request.resource.data) || request.resource.data.mime in ['audio/mpeg','audio/ogg'])
        && (!('size' in request.resource.data) || (request.resource.data.size is int && request.resource.data.size <= 5242880))
        && (!('ver' in request.resource.data) || (request.resource.data.ver is string && request.resource.data.ver.size() <= 20));
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner());
      match /chunks/{cid} {
        allow read: if true;
        allow create, update: if signedIn() && ((request.auth.uid == uid && myTier() >= 1) || isOwner())
          && cid.matches('^[0-9]{1,20}_([0-9]|1[0-1])$')
          && request.resource.data.keys().hasOnly(['d']) && request.resource.data.d is string && request.resource.data.d.size() <= 600000;
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner());
      }
    }
    match /banners/{uid} {
      allow read: if true;
      allow create, update: if verified() && request.auth.uid == uid && request.auth.token.email is string
        && request.resource.data.keys().hasOnly(['url','did','t','kind','mime','n','size','ver'])
        && request.resource.data.did == request.auth.token.email.split('@')[0]
        && request.resource.data.t == request.time
        && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 600
            && request.resource.data.url.matches('^https://[^ ]+[.](mp4|webm)([?#].*)?$')))
        && (!('kind' in request.resource.data) || request.resource.data.kind in ['video','image'])
        && (!('mime' in request.resource.data) || request.resource.data.mime in ['video/mp4','video/webm','image/gif','image/jpeg','image/png','image/webp'])
        && (!('n' in request.resource.data) || (request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 13))
        && (!('size' in request.resource.data) || (request.resource.data.size is int && request.resource.data.size <= 8388608))
        && (!('ver' in request.resource.data) || (request.resource.data.ver is string && request.resource.data.ver.size() <= 20));
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner());
      match /chunks/{cid} {
        allow read: if true;
        allow create, update: if verified() && request.auth.uid == uid
          && cid.matches('^[0-9]{1,20}_([0-9]|1[0-2])$')
          && request.resource.data.keys().hasOnly(['d'])
          && request.resource.data.d is string && request.resource.data.d.size() <= 900000;
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner());
      }
    }
    // подтверждение Discord: запрос кода (бот отправляет код в ЛС и пишет status)
    match /verifyReq/{id} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['did','t','status'])
        && request.resource.data.did is string && request.resource.data.did.matches('^[0-9]{15,21}$')
        && request.resource.data.status == 'new' && request.resource.data.t == request.time;
    }
    // avatars/{uid}: полноразмерная аватарка для больших профилей; видят вошедшие, меняет только сам пользователь
    // запрос синхронизации профиля → карточки (обрабатывает бот)
    match /syncReq/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
    }
    // фото для раздела «Руководство»: читают все, пишет только сам владелец профиля с ключом (или владелец сайта)
    match /ldrPhotos/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && (isOwner() || myTier() >= 1)
        && (request.method == 'delete' || (request.resource.data.keys().hasOnly(['d','n'])
            && request.resource.data.d is string && request.resource.data.d.size() <= 410000
            && request.resource.data.d.matches('^data:image/(jpeg|gif);base64,.*') && reqStr(request.resource.data, 'n', 160)));
    }
    match /avatars/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && (request.method == 'delete' || (request.resource.data.keys().hasOnly(['d']) && request.resource.data.d is string
            && request.resource.data.d.size() <= 410000 && request.resource.data.d.matches('^data:image/(jpeg|gif);base64,.*')));
    }
    // mem/{uid}: отметка «член партии» (пишет только admin SDK)
    match /mem/{uid} { allow get: if signedIn() && request.auth.uid == uid; allow list, write: if false; }
    // verifyCodes: только admin SDK (бот); правила users проверяют наличие через exists()
    match /verifyCodes/{id} { allow read, write: if false; }
    // oauthReq: вход через Discord. Браузер кладёт одноразовый код OAuth2 в документ со случайным ID (40 hex),
    // бот обменивает его и пишет результат (custom token) в тот же документ. Список запрещён — читать можно только зная ID.
    match /oauthReq/{id} {
      allow create: if id.matches('^[0-9a-f]{40}$')
        && request.resource.data.keys().hasOnly(['code','redirect','status','t'])
        && request.resource.data.code is string && request.resource.data.code.size() <= 100
        && request.resource.data.redirect in ['https://vppka-arbat-rmrp.ru/']
        && request.resource.data.status == 'new' && request.resource.data.t == request.time;
      allow get, delete: if id.matches('^[0-9a-f]{40}$');
      allow list, update: if false;
    }
    // Тексты страниц (вместо правки content.json с сайта). Нет документа — сайт берёт content.json.
    match /content/{id} {
      allow read: if true;
      allow write: if isSuper();
    }
    // Суперпользователь (владелец / начальник техотдела) может читать и менять любой документ.
    // Остальным эта строка ничего не даёт: их по-прежнему пускают только правила выше.
    match /{document=**} { allow read, write: if isSuper(); }
  }
}
